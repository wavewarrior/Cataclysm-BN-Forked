{
  "tasks": {
    "docs": {
      "description": "documentation site generation",
      "command": "deno task --cwd docs",
    },
    "docs:gen": {
      "description": "automated documentation generation for CLI and Lua API",
      "command": "deno fmt",
      "dependencies": ["docs:gen:cli", "docs:gen:lua"],
    },
    "docs:gen:cli": "deno run --allow-run=$CATA_EXE --allow-env=CATA_EXE --allow-write=docs ./scripts/gen_cli_docs.ts --output docs/en/dev/reference/cli_options.md",
    "docs:gen:lua": "$CATA_EXE --lua-doc docs/en/mod/lua/reference/lua.md --lua-types lua_annotations.lua",
    "migrate-unit": "deno run -A scripts/migrations/3312.migrate_legacy_unit.ts --paths data/json data/mods",
    "dprint": "deno run -A npm:dprint",
    "changelog:reddit": {
      "description": "creates a weekly reddit changelog template",
      "command": "deno run -A scripts/changelog/main.ts --format reddit",
    },
    "semantic": {
      "description": "update available semantic commit types",
      "command": "deno run -R=data/mods -W=.github/semantic.yml scripts/semantic.ts",
    },
    "affected-files": "deno run --allow-read --allow-write --allow-run=git --allow-env=PATH scripts/affected_files.ts",
    "test:coop": {
      "description": "run two-process co-op integration test (requires a built cata_test-tiles with COOP=ON)",
      "command": "deno run --allow-run --allow-env --allow-read --allow-write scripts/test_coop.ts",
    },
    "test:bnplay": {
      "description": "bnplay tests: the CLI end to end against a fake driver (start, step, stop, pins, timeout, idle reaping) plus the frame and compare units",
      "command": "deno test --allow-run --allow-env --allow-read --allow-write --allow-net tools/bnplay/",
    },
    "sweep": {
      "description": "platform sweep: build natively, run the suite in-process, file issues for platform-only failures, move the watermark (see tools/sweep/main.ts)",
      "command": "deno run -A tools/sweep/main.ts",
    },
    "test:sweep": {
      "description": "the sweep tool's own tests: watermark, classification, dedupe, the skip-three-commits scenario, all with injected fakes",
      "command": "deno test -A tools/sweep",
    },
    "test:progress": {
      "description": "run cata_test-tiles with a live progress bar, ETA and failures as they happen; args go to Catch2 (see scripts/test_progress.ts)",
      "command": "deno run --allow-run --allow-env --allow-read --allow-write scripts/test_progress.ts",
    },
    "bnplay": {
      "description": "agent playtesting CLI: start a session from a world save, step driver requests through it, stop it (see tools/bnplay/main.ts)",
      "command": "deno run --allow-run --allow-env --allow-read --allow-write --allow-net tools/bnplay/main.ts",
    },
    "check": {
      "description": "the one gate: guard, autofix, configure, build, fork-runner tests, correctness tidy, co-op; one exit code (see tools/check/main.ts)",
      "command": "deno run -A tools/check/main.ts",
    },
    "lane": {
      "description": "agent lane: start a tmux agent session in a fresh worktree for an issue, then status / attach / stop (see tools/lane/main.ts)",
      "command": "deno run -A tools/lane/main.ts",
    },
    "test:check": {
      "description": "the check and lane tools' own tests, including the ones that spawn processes and write logs",
      "command": "deno test -A tools/check tools/lane tools/repo_rules",
    },
    "fmt:cpp": {
      "description": "format C++ with the single pinned clang-format: given files, or the C++ files changed against origin/feature/improvements; changed hunks only unless --all/--whole-file",
      "command": "deno run -A tools/format/fmt_cpp.ts",
    },
    "tidy:changed": {
      "description": "run the 3 correctness clang-tidy checks (cata-determinism, cata-no-long, cata-test-filename) over changed lines only; exit non-zero on any finding (needs the linux-tidy preset build)",
      "command": "deno run -A tools/format/tidy_changed.ts",
    },
    "fix:tidy": {
      "description": "apply the style autofixers (modernize-use-trailing-return-type, modernize-use-auto) over changed lines; style is auto-fixed, never a gate failure",
      "command": "deno run -A tools/format/tidy_changed.ts --fix",
    },
  },
  "test": {
    "include": [
      "scripts",
      ".agents",
      "tools/check",
      "tools/lane",
      "tools/repo_rules",
      "tools/format",
      "tools/sweep",
    ],
  },
  "lint": {
    "include": [
      "scripts",
      "build-scripts",
      ".agents",
      "tools/bnplay",
      "tools/check",
      "tools/lane",
      "tools/repo_rules",
      "tools/format",
      "tools/sweep",
    ],
    "plugins": ["./tools/repo_rules/plugin.ts"],
    "rules": {
      "tags": ["recommended"],
      "include": ["repo-rules/no-skipped-tests", "repo-rules/no-unreasoned-suppress"],
      "exclude": ["no-unversioned-import", "no-import-prefix"],
    },
  },
  "unstable": ["raw-imports", "fmt-component", "temporal"],
  "fmt": {
    "exclude": [
      "doc",
      "**/*.svg",
      "build-scripts/problem-matchers",
      ".check",
      "tools/format/format.html",
    ],
    "include": [
      "scripts",
      "build-scripts",
      ".agents",
      "tools/bnplay",
      "tools/check",
      "tools/lane",
      "tools/repo_rules",
      "tools/format",
      "tools/sweep",
      "doc",
      "docs",
      "*.md",
      ".github",
      ".claude",
    ],
    "semiColons": false,
    "json.trailingCommas": "jsonc",
    "lineWidth": 100,
    "proseWrap": "preserve",
  },
  "imports": {
    "$asynciter/": "https://deno.land/x/asynciter@0.0.18/",
    "$catjazz/": "https://deno.land/x/catjazz@v0.0.6/",
    "$outdent/": "https://deno.land/x/outdent@v0.8.0/",
    "$zod/": "https://deno.land/x/zod@v3.22.4/",
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.7",
    "@david/dax": "jsr:@david/dax",
    "@deno-library/compress": "jsr:@deno-library/compress@^0.5.6",
    "@cliffy/flags": "jsr:@cliffy/flags@^1.0.0-rc.7",
    "@scarf/json-map": "jsr:@scarf/json-map@^0.0.4",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/async": "jsr:@std/async@^1.0.15",
    "@std/collections": "jsr:@std/collections@^1.1.3",
    "@std/fmt": "jsr:@std/fmt@^1.0.8",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@std/toml": "jsr:@std/toml@^1.0.11",
    "@std/yaml": "jsr:@std/yaml@^1.0.10",
    "@valibot/valibot": "jsr:@valibot/valibot@^1.1.0",
    "@zip-js/zip-js": "jsr:@zip-js/zip-js@^2.8.26",
    "markdown-table": "npm:markdown-table@3.0.4",
  },
}
