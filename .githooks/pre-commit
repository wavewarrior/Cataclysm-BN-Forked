#!/usr/bin/env bash
# Dependency-free replacement for the `fmt` hook in .pre-commit-config.yaml.
# Formats staged files only (repo-wide `deno fmt` would reformat every dirty
# .md/.ts). Files that are ALSO dirty in the working tree (partly staged) are
# skipped with a warning: formatters run on the working-tree file, so restaging
# them would silently commit the user's unstaged hunks.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

build-scripts/check-skills.sh

DENO="$(command -v deno || echo "$HOME/.deno/bin/deno")"
if [[ ! -x "$DENO" ]]; then
    echo "warning: deno not found; skipping md/ts/lua formatting" >&2
    DENO=""
fi

cpp_files=()
json_files=()
doc_files=()
lua_files=()
while IFS= read -r -d '' file; do
    [[ -f "$file" ]] || continue
    if ! git diff --quiet --name-only -z -- "$file" 2>/dev/null; then
        # staged AND unstaged: formatting the worktree file would swallow the
        # unstaged hunks when we restage. Leave it to the author.
        echo "warning: $file is partly staged; not formatting (git add it fully or stash the rest)" >&2
        continue
    fi
    case "$file" in
        *.cpp | *.h | *.hpp) cpp_files+=("$file") ;;
        *.json) json_files+=("$file") ;;
        *.md | *.ts) doc_files+=("$file") ;;
        *.lua) lua_files+=("$file") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if ((${#cpp_files[@]})); then build-scripts/format-cpp.sh "${cpp_files[@]}"; fi
if ((${#json_files[@]})); then build-scripts/format-json.sh "${json_files[@]}"; fi
if [[ -n "$DENO" ]]; then
    if ((${#doc_files[@]})); then "$DENO" fmt "${doc_files[@]}"; fi
    if ((${#lua_files[@]})); then "$DENO" task dprint fmt "${lua_files[@]}"; fi
fi

staged=(${cpp_files[@]+"${cpp_files[@]}"} ${json_files[@]+"${json_files[@]}"} ${doc_files[@]+"${doc_files[@]}"} ${lua_files[@]+"${lua_files[@]}"})
if ((${#staged[@]})); then git add -- "${staged[@]}"; fi
