#!/usr/bin/env bash
# Dependency-free replacement for the `fmt` hook in .pre-commit-config.yaml.
# Formats staged files only (repo-wide `deno fmt` would reformat every dirty
# .md/.ts). Files that are ALSO dirty in the working tree (partly staged) are
# skipped with a warning: formatters run on the working-tree file, so restaging
# them would silently commit the user's unstaged hunks.
#
# C++ goes through `deno task fmt:cpp --staged`: the single pinned clang-format,
# restricted to the staged hunks, so untouched lines are never reformatted.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

build-scripts/check-skills.sh

DENO="$(command -v deno || echo "$HOME/.deno/bin/deno")"
if [[ ! -x "$DENO" ]]; then
    echo "warning: deno not found; skipping C++/md/ts/lua formatting" >&2
    DENO=""
fi

cpp_files=()
json_files=()
doc_files=()
lua_files=()
while IFS= read -r -d '' file; do
    [[ -f "$file" ]] || continue
    if ! git diff --quiet --name-only -z -- "$file" 2>/dev/null; then
        # staged AND unstaged: formatting the worktree file would swallow the
        # unstaged hunks when we restage. Leave it to the author.
        echo "warning: $file is partly staged; not formatting (git add it fully or stash the rest)" >&2
        continue
    fi
    case "$file" in
        *.cpp | *.h | *.hpp) cpp_files+=("$file") ;;
        *.json) json_files+=("$file") ;;
        *.md | *.ts) doc_files+=("$file") ;;
        *.lua) lua_files+=("$file") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [[ -n "$DENO" ]]; then
    if ((${#cpp_files[@]})); then
        "$DENO" run -A tools/format/fmt_cpp.ts --staged "${cpp_files[@]}"
    fi
    if ((${#json_files[@]})); then build-scripts/format-json.sh "${json_files[@]}"; fi
    if ((${#doc_files[@]})); then "$DENO" fmt "${doc_files[@]}"; fi
    if ((${#lua_files[@]})); then "$DENO" task dprint fmt "${lua_files[@]}"; fi
fi

staged=(${cpp_files[@]+"${cpp_files[@]}"} ${json_files[@]+"${json_files[@]}"} ${doc_files[@]+"${doc_files[@]}"} ${lua_files[@]+"${lua_files[@]}"})
if ((${#staged[@]})); then git add -- "${staged[@]}"; fi

# Advisory fan-out report (issue #181): a staged hub header drags hundreds of TUs into
# every rebuild that touches it. Print one line per staged src/ header whose fan-out is at
# least FANOUT_ADVISORY_THRESHOLD (default 100) TUs. Strictly advisory: every failure path
# degrades to a warning, the commit is never blocked and this never changes the exit code.
if [[ -n "$DENO" ]]; then
    fanout_threshold="${FANOUT_ADVISORY_THRESHOLD:-100}"
    if [[ ! "$fanout_threshold" =~ ^[0-9]+$ ]]; then
        echo "warning: FANOUT_ADVISORY_THRESHOLD='$fanout_threshold' is not a number; using 100" >&2
        fanout_threshold=100
    fi
    fanout_tab="$(printf '\t')"
    while IFS= read -r -d '' file; do
        case "$file" in src/*.h | src/*.hpp) ;; *) continue ;; esac
        [[ -f "$file" ]] || continue
        line="$("$DENO" run --allow-read --allow-run=git,ninja tools/fanout/main.ts --text --porcelain "$file" 2>/dev/null)" || line=""
        rest="${line#*"$fanout_tab"}"
        count="${rest%%"$fanout_tab"*}"
        if [[ ! "$count" =~ ^[0-9]+$ ]]; then
            echo "warning: fanout advisory skipped for $file" >&2
            continue
        fi
        if ((count >= fanout_threshold)); then
            echo "fanout advisory: $file reaches $count TUs (threshold $fanout_threshold); a change here rebuilds them all"
        fi
    done < <(git diff --cached --name-only --diff-filter=ACMR -z)
fi
