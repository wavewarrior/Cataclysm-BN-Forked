/* Lua dev console — full-screen panel with scrolling log + prompt */

.lua-con-panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 4dp;
    background-color: #0a0a0a;
    border: 1dp solid #444;
}

/* Scrolling log area takes all spare vertical space */
.lua-log {
    flex: 1 1 auto;
    overflow-y: auto;
    display: block;
    margin-bottom: 4dp;
    font-size: 14dp;
    font-family: Terminus;
}

.lua-entry {
    display: block;
    white-space: pre-wrap;
    color: #cccccc;
    line-height: 1.2em;
}

.lua-entry.lua-input {
    color: #88cc88;
    padding-left: 12dp;
}

.lua-entry.lua-input.lua-head {
    padding-left: 4dp;  /* "> " shown via text, so less indent */
}

/* Hint text between log and prompt */
.lua-hints {
    flex: 0 0 auto;
    display: block;
    color: #aaaaaa;
    font-size: 13dp;
    font-family: Terminus;
    white-space: pre-wrap;
    border-top: 1dp solid #333;
    border-bottom: 1dp solid #333;
    padding: 2dp 0;
    margin-bottom: 4dp;
}

/* Prompt preview */
.lua-prompt {
    flex: 0 0 auto;
    display: block;
    overflow: hidden;
    max-height: 120dp;   /* ~5 lines at 14dp font; TOGGLE_EXPANDED may need more */
    font-size: 14dp;
    font-family: Terminus;
    border: 1dp solid #444;
    padding: 2dp;
    background-color: #050505;
}

.lua-pline {
    display: block;
    white-space: pre;
    color: #cccccc;
    line-height: 1.2em;
}

.lua-pnum {
    color: #555555;
    margin-right: 4dp;
}

.lua-ptext {
    color: #dddddd;
}

/* Footer: key summary */
.lua-footer {
    flex: 0 0 auto;
    display: block;
    color: #777777;
    font-size: 12dp;
    font-family: Terminus;
    white-space: pre-wrap;
    padding-top: 2dp;
}
