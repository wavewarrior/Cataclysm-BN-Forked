/* Layout for the new-character TRAITS tab (Tier 4 #4 slice 4).
   Linked AFTER newchar_common.rcss, so a same-specificity rule here wins.

   ROW based, after UI_designs/11_charcreation_mutations.png — the shared row-list vocabulary
   (newchar_common.rcss) plus this step's own DNA strand and panel proportions.
   See plans/charcreation-traits-tree.md. */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.nc-panel {
    width: 98%;
    height: 98%;
    display: flex;
    flex-direction: column;
}

.nc-steps {
    flex: 0 0 auto;
}

.nc-step {
    flex: 0 0 auto;
}

/* ── LISTS ────────────────────────────────────────────────────────────────────
   The meta bar, the dotted rules, the three columns and every row cell are the SHARED row-list
   vocabulary in newchar_common.rcss (.nc-meta, .nc-rule, .nc-cols, .nc-row, .nc-cell-*), promoted
   there when BIONICS became the second adopter. Only the DNA strand below is this step's own. */

/* ── DNA STRAND ───────────────────────────────────────────────────────────────
   A full-height column beside the lists. 120dp of box holds 100dp of travel plus the 10dp dot and
   a little air, which is why the producer scales newchar_dna.h's fractions by exactly 100. The
   three lists give up ~11dp each for it, which they do not miss. */
.nc-dna-wrap {
    flex: 0 0 auto;
    width: 120dp;
    display: flex;
    flex-direction: column;
}

.nc-dna {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

/* Every rung takes an equal share of whatever height the column has, so the strand rescales with
   the window and never needs a rung count matched to a pixel height. */
.nc-dna-rung {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
}

/* The leading gap and the bond are the only animated properties: C++ writes their widths each
   frame and the two dots fall where flow puts them. */
.nc-dna-gap {
    flex: 0 0 auto;
}

/* Rails between the pair. Dim, because it is the connection and not the data. */
.nc-dna-bond {
    flex: 0 0 auto;
    height: 1dp;
    background-color: {{bg3}};
}

.nc-dna-dot {
    flex: 0 0 auto;
    width: 10dp;
    height: 10dp;
    border-radius: 5dp;
    /* Back half of the turn: recedes. Depth is carried by brightness alone — sizing the dots per
       rung would change the flow widths and fight the gap arithmetic. */
    background-color: {{bg4}};
}

/* Front half of the turn: nearer the viewer. */
.nc-dna-dot.front {
    background-color: {{fg4}};
}

/* A trait the player has taken, lit by valence — the same green/red the cost tags and the balance
   scale use, so all three agree. Three classes beat `.front` on specificity, so a marked pair
   stays its own colour through the whole turn rather than flickering with depth. */
.nc-dna-dot.good {
    background-color: {{green}};
}

.nc-dna-dot.bad {
    background-color: {{red}};
}

.nc-dna-dot.cosm {
    background-color: {{yellow}};
}

/* ── DETAIL ───────────────────────────────────────────────────────────────────
   The shared `.nc-selname` header sits above the art | facts | prose panel; only the panel's own
   proportions are this step's business. */

/* Shorter than the card tabs' 188dp: this tab spends its height on three long lists, and the
   panel carries three facts plus prose rather than facts plus two rows of chips. Taller than the
   132dp first pass purely to give the portrait room — see .nc-info-art. */
.nc-info-panel {
    height: 196dp;
}

/* The portrait is a `scale-none` window into a 512px render target, so this box does not resize the
   character — it decides how much of the target is visible. At 108dp (216 physical px on a 2x
   display) the avatar reached the edges and read as cropped; 168dp shows it whole with air around
   it. To shrink the CHARACTER rather than the window, zoom is the control: character_preview
   defaults to DEFAULT_ZOOM == MAX_ZOOM (128), and one zoom_out() in nc_prepare_preview would halve
   it for all four preview tabs at once. */
.nc-info-art {
    width: 168dp;
    height: 168dp;
}

