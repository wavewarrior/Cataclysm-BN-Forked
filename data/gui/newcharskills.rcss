/* Layout for the new-character SKILLS tab (Tier 4 #4 slice 3). Reuses theme
   .panel / .tabs / .tab / .item / .scroll-pane. body sized + centered (the
   missions gotcha); rows need explicit display (the inline-row gotcha). */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

/* 72%, not 80/92%: the character-preview box is pinned to the right of the screen
   and its avatar is a GPU sprite drawn UNDERNEATH this document, so an opaque panel
   reaching over that box hides the sprite. A centred panel of width W has its right
   edge at (100+W)/2, so 72% ends at 86% and the box starts at ~86.7% — they never
   meet. 80% (right edge 90%) cleared the old box by 0.2% by luck; 92% covered it.
   Keep all eight tabs identical so the panel edge does not jump while tabbing.
   See nc_prepare_preview() in newcharacter_ui.cpp. */
.nc-panel {
    width: 72%;
    min-width: 720dp;
    height: 92%;
    display: flex;
    flex-direction: column;
}

.nc-tabs {
    flex: 0 0 auto;
}

.nc-tabs .tab {
    flex: 0 0 auto;
}

.nc-points {
    display: block;
    flex: 0 0 auto;
    padding: 8dp 8dp 0 8dp;
    color: {{fg}};
}

.nc-cost {
    display: block;
    flex: 0 0 auto;
    padding: 2dp 8dp 6dp 8dp;
}

.nc-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

.nc-skill-list {
    flex: 0 0 auto;
    min-width: 320dp;
    border-right: 1dp {{bg4}};
    padding-right: 8dp;
}

.nc-skill-row {
    display: block;
}

/* Category headers are plain coloured labels, not filled .item rows. */
.nc-skill-row.header {
    background-color: transparent;
    margin-top: 6dp;
}

.nc-skill-desc {
    flex: 1;
    min-width: 0;
    white-space: pre-wrap;
    padding: 8dp;
    color: {{fg}};
}
