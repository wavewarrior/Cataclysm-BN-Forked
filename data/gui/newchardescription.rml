<rml>
<head>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="newchar_common.rcss"/>
    <link type="text/rcss" href="newchardescription.rcss"/>
</head>
<body data-model="newchardescription">
    <!-- Tier 4 screen #4 (new-character creator) slice 8: the OVERVIEW tab
         (set_description) — the final summary form. Char-tab strip (OVERVIEW
         current) + points line + an edit row (name/gender/height/age/location,
         the selected field marked with "> ") + scenario/profession + six summary
         columns + a keybinding guide footer.

         Each column is built as EXPLICIT ROWS (nc_desc_pane/nc_desc_row in
         newcharacter_ui.cpp) rather than one "\n"-joined string. Two reasons: the
         column title and group headings then have their own elements so they can
         carry real typographic weight, and a label can never weld to its value —
         `colorize(label) + " " + colorize(value)` puts U+0020 between two spans,
         where RmlUi trims it at parse time.

         Render-only doc; keyboard owns LEFT/RIGHT/UP/DOWN/CONFIRM/TAB/BACKTAB. -->
    <div class="panel nc-panel">
        <div class="nc-steps">
            <div class="nc-step" data-for="t : tabs"
                 data-class-selected="t.selected" data-class-done="t.done">
                <div class="nc-step-icon" data-style-decorator="t.icon_dec"></div>
                <span class="nc-step-label" data-rml="t.name_rml"></span>
            </div>
        </div>
        <div class="nc-shell">
            <!-- Navigators. Shortcut text comes from the real binding via
                 input_context::get_desc, so it stays correct after a rebind. -->
            <div class="nc-arrow nc-arrow-prev" data-if="has_prev"
                 data-event-click="on_prev()">
                <div class="nc-arrow-glyph">&#60;</div>
                <div class="nc-arrow-key" data-rml="prev_key_rml"></div>
                <div class="nc-arrow-dest" data-rml="prev_name_rml"></div>
            </div>
            <div class="nc-arrow-spacer" data-if="!has_prev"></div>
            <div class="nc-stage">
                <!-- Character portrait. Ordinary document content now: the avatar is
                     drawn into its own render target and arrives as a decorator, so it
                     is no longer a GPU sprite pinned outside the panel. -->
                <div class="nc-portrait" data-if="has_portrait"
                     data-style-decorator="portrait_dec"></div>
            <div class="nc-desc-points" data-rml="points_rml"></div>
            <div class="nc-desc-editrow">
                <span class="nc-desc-field" data-rml="name_rml"></span>
                <span class="nc-desc-field" data-rml="gender_rml"></span>
                <span class="nc-desc-field" data-rml="height_rml"></span>
                <span class="nc-desc-field" data-rml="age_rml"></span>
                <span class="nc-desc-field" data-rml="location_rml"></span>
            </div>
            <div class="nc-desc-sp">
                <span class="nc-desc-field" data-rml="scenario_rml"></span>
                <span class="nc-desc-field" data-rml="profession_rml"></span>
            </div>
            <div class="nc-desc-panes">
                <div class="nc-desc-pane" data-for="pane : panes">
                    <div class="nc-pane-head">
                        <div class="nc-pane-icon" data-style-decorator="pane.icon_dec"></div>
                        <span class="nc-pane-title" data-rml="pane.title_rml"></span>
                    </div>
                    <div class="nc-pane-body scroll-pane">
                        <div class="nc-pane-row" data-for="r : pane.rows"
                             data-class-heading="r.heading">
                            <span class="nc-pane-label" data-rml="r.label_rml"></span>
                            <span class="nc-pane-value" data-rml="r.value_rml"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="nc-desc-guide" data-rml="guide_rml"></div>
            </div>
            <div class="nc-arrow nc-arrow-next" data-if="has_next"
                 data-event-click="on_next()">
                <div class="nc-arrow-glyph">&#62;</div>
                <div class="nc-arrow-key" data-rml="next_key_rml"></div>
                <div class="nc-arrow-dest" data-rml="next_name_rml"></div>
            </div>
            <div class="nc-arrow-spacer" data-if="!has_next"></div>
        </div>
        <div class="nc-exit" data-rml="exit_rml"></div>
    </div>
    <div id="crt-overlay" class="crt"></div>
</body>
</rml>
