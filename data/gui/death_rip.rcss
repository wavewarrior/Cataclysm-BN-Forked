/* Death / RIP screen layout (game::cleanup_at_end).
   Full-screen centred panel: gravestone art block + stats + memorial.
   Lengths in dp (see theme.rcss). Palette hexes copied from theme.rcss. */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.rip-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 90%;
    max-height: 95%;
    overflow-y: auto;
    padding: 8dp 24dp;
}

/* ASCII art block — Terminus is already monospace; &nbsp; preserves column
   alignment. Left-aligned within the centred panel so the art isn't skewed. */
.rip-art {
    display: block;
    text-align: left;
    margin-bottom: 18dp;
    line-height: 1.1;
    color: {{fg4}};
}

/* Survival stats: one line each, centred. */
.rip-stats {
    display: block;
    text-align: center;
    margin-bottom: 14dp;
}

.rip-stat {
    display: block;
    text-align: center;
}

/* "In memory of: / <name>" block, centred, muted label + bright name. */
.rip-memorial {
    display: block;
    text-align: center;
    color: {{fg4}};
    margin-bottom: 14dp;
}

/* Prompt shown while string_input_popup collects the last words. */
.rip-lastwords-prompt {
    display: block;
    text-align: center;
    color: {{fg4}};
    margin-top: 4dp;
}
