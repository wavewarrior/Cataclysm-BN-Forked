/* Layout for the vehicle interaction screen (§8.1 backlog, the giant — slice 1).
   Palette/border come from theme.rcss (linked first in veh_interact.rml); this
   file owns only the screen's own layout. Lengths in dp. SLICE 1 styles the name
   line, a placeholder body, and the bottom action mode bar; later slices add the
   real panes. Bound spans carry their own colour via cata_text_to_rml. */
body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.vi-panel {
    width: 90%;
    height: 90%;
    display: flex;
    flex-direction: column;
}

.vi-name {
    flex: 0 0 auto;
    border-bottom: 1dp {{bg4}};
    padding-bottom: 2dp;
    margin-bottom: 2dp;
    white-space: nowrap;
}

.vi-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

/* Each half of the body stacks two panes vertically. Left: stats + parts.
   Right (slice 4): overview + message/descriptions. */
.vi-col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.vi-col-mid, .vi-col-right {
    border-left: 1dp {{bg4}};
    margin-left: 4dp;
    padding-left: 4dp;
}

/* Slice 5: the 2D vehicle diagram — a monospace glyph grid (theme font is
   monospace) under white-space:pre so columns line up. One row element per
   w_disp line; each cell carries its own colour. */
.vi-diagram {
    flex: 1;
    min-height: 0;
    overflow: auto;
    padding: 2dp;
}

.vi-diag-row {
    display: block;
    white-space: pre;
}

/* Slice 2: the stats pane. One \n-joined string → pre-wrap line breaks;
   native scroll if it overflows. Each line carries its own colour. */
.vi-stats {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    white-space: pre-wrap;
    padding: 2dp;
}

/* Slice 4: the parts-at-tile list + the message/descriptions pane. Both are
   single pre-wrap strings; native scroll. A separator splits each from the
   pane above it in its column. */
.vi-parts, .vi-msg {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    white-space: pre-wrap;
    padding: 2dp;
    border-top: 1dp {{bg4}};
    margin-top: 2dp;
}

/* Slice 3: the overview pane (engines/tanks/batteries/… grouped list). Rows
   are a left column (header label / "hotkey name") + a right-aligned detail
   column. Headers get a top gap; the selected entry takes the accent. */
.vi-overview {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 2dp;
}

.vi-ov-row {
    display: flex;
    justify-content: space-between;
    white-space: nowrap;
}

/* Mouse interactivity (Step 2): clickable overview/install rows get a
   pointer cursor + the crafting.rcss hover treatment (.cg-row:hover),
   placed before .selected so an actively-selected row keeps its accent
   color instead of flickering to the hover shade. Header rows
   (data-class-header -> .header) are not selectable, so they keep the
   default cursor and no hover background. */
.vi-ov-row:hover {
    background-color: {{bg2}};
    color: {{fg0}};
    cursor: pointer;
}

.vi-ov-row.header:hover {
    background-color: transparent;
    color: {{fg3}};
    cursor: default;
}

.vi-ov-row.header {
    margin-top: 6dp;
    color: {{fg3}};
}

.vi-ov-row.selected {
    background-color: {{accent}};
    color: {{bg0}};
}

.vi-ov-detail {
    margin-left: 8dp;
}

/* Slice 6: the right column swaps between normal mode (overview+msg) and the
   install/repair sub-mode (subtab bar + vpart list + detail). Each mode wrapper
   fills its column. */
.vi-mode-overview, .vi-mode-install {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
}

.vi-inst-tabs {
    flex: 0 0 auto;
    white-space: nowrap;
    margin-bottom: 2dp;
}

.vi-inst-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 2dp;
}

.vi-inst-details {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    white-space: pre-wrap;
    padding: 2dp;
    border-top: 1dp {{bg4}};
    margin-top: 2dp;
}

.vi-mode {
    flex: 0 0 auto;
    border-top: 1dp {{bg4}};
    padding-top: 2dp;
    margin-top: 2dp;
    white-space: pre-wrap;
}
