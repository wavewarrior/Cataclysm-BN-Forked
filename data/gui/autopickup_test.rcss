/* Layout for the auto_pickup test-rule popup (user_interface::test_pattern).
   Palette/border/scrollbar/.scroll-pane and the .panel frame come from theme.rcss
   (linked first in autopickup_test.rml); this file owns only this popup's layout.
   A centered box over the rules screen behind it; the cursor row gets the accent.
   Lengths in dp. */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.apt-panel {
    width: 62%;
    height: 78%;
    display: flex;
    flex-direction: column;
}

.apt-title {
    flex: 0 0 auto;
    text-align: center;
    padding-bottom: 4dp;
    margin-bottom: 4dp;
    border-bottom: 1dp {{bg4}};
}

.apt-list {
    flex: 1;
    min-height: 0;
}

.apt-row {
    display: flex;
    flex-direction: row;
    padding: 2dp 6dp;
    border-radius: 4dp;
}

.apt-row:hover {
    background-color: {{bg2}};
}

.apt-row.selected {
    background-color: {{yellow}};
    color: {{bg-hard}};
}

.apt-num {
    flex: 0 0 48dp;
}

.apt-name {
    flex: 1;
}

.apt-footer {
    flex: 0 0 auto;
    text-align: center;
    margin-top: 4dp;
    color: {{red}};
}
