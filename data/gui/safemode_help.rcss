/* Layout for the safe mode wildcard help backdrop (safemode::show, EDIT rule).
   Palette/border come from theme.rcss (linked first); this file owns only this
   popup's layout. Positioned upper-centre so the string_input "Safe Mode Rule:"
   box (drawn over it) stays clear, mirroring the curses help window. Lengths in dp.
   Monospace + white-space: pre keep the example columns aligned. Shared by the
   monster + sound help variants. */

body {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    height: 100%;
}

.smh-panel {
    margin-top: 14%;
    max-width: 80%;
    display: flex;
    flex-direction: column;
}

.smh-text {
    white-space: pre;
}
