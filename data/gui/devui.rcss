/* Tier 8 — RmlUi dev-panel preview styling. An opaque box pinned top-left so it doesn't
   fight the ImGui F4 window. Interactive doc (mouse).

   IMPORTANT — authored in PX, NOT dp/em-on-dp. `ui_scale()` multiplies the context-wide
   density-independent-pixel ratio (rmlui_layer SetDensityIndependentPixelRatio), so every
   `dp` unit in every doc scales with it. The dev panel hosts the UI-scale slider itself, so
   if it scaled too it would reflow under the cursor as you drag (unusable). `px` is raw
   pixels — immune to the dp ratio — so the panel stays a fixed size while the slider
   rescales the rest of the UI. (em here resolves against a px font-size, so it is stable
   too; vh is viewport-relative, also independent of ui_scale.) */

body {
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.devui-panel {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 400px;
    height: 660px;           /* definite height — resizable from C++; lets bottom:0 resolve */
    display: flex;
    flex-direction: column;
    padding: 12px;
    background-color: #1e1e1ef0;
    border: 1px #555555;
    color: #dddddd;
    font-size: 18px;
    pointer-events: auto;
}

.devui-title {
    flex: 0 0 auto;
    font-size: 22px;
    color: #ffffff;
    margin-bottom: 8px;
}

/* Slice 7 — tab bar (data-class-active="tab==N") + scrolling body region + drag-resize
   handle. The body owns the scroll (was on the panel); the resize handle sets the panel
   width + body height from C++, so the panel grows and the rows scroll within it. */
.devui-tabs {
    flex: 0 0 auto;
    display: block;
    margin-bottom: 6px;
}

.devui-tab {
    display: inline-block;
    padding: 3px 9px;
    margin-right: 2px;
    margin-bottom: 2px;
    background-color: #2a2a2a;
    border: 1px #555555;
    color: #aaaaaa;
    font-size: 15px;
}

.devui-tab:hover {
    color: #ffffff;
    border-color: #888888;
}

.devui-tab.active {
    background-color: #2a4566;
    color: #ffffff;
    border-color: #8ab4f8;
}

.devui-body {
    flex: 1 1 auto;          /* fills the panel below the tab bar (definite parent height) */
    display: block;
    overflow-y: auto;
    min-height: 0;           /* allow the flex item to shrink so overflow scrolls */
}

.devui-resize {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 16px;
    height: 16px;
    background-color: #555555;
    drag: drag;              /* required for RmlUi to emit drag events */
}

.devui-resize:hover {
    background-color: #8ab4f8;
}

/* Slice 8 — clickable button (event-click span), inline note, diagnostics read-out. */
.devui-btn {
    display: inline-block;
    padding: 2px 8px;
    margin-right: 4px;
    margin-top: 2px;
    background-color: #333355;
    border: 1px #6677aa;
    color: #dddeff;
}

.devui-btn:hover {
    background-color: #44447a;
    border-color: #99aaff;
}

.devui-note {
    color: #888888;
    font-size: 14px;
    margin-bottom: 4px;
}

.devui-diag {
    display: block;
    white-space: pre-wrap;
    font-size: 15px;
    color: #b8d8b8;
}

.devui-section {
    color: #8ab4f8;
    margin-top: 10px;
    margin-bottom: 3px;
}

.devui-row {
    display: block;
    margin-bottom: 2px;
}

input.checkbox {
    width: 16px;
    height: 16px;
    border: 1px #888888;
    background-color: #141414;
    vertical-align: -3px;
    margin-right: 6px;
}

input.checkbox:hover {
    border-color: #cccccc;
}

input.checkbox:checked {
    background-color: #5fdd5f;
    border-color: #5fdd5f;
}

/* Range slider — sub-elements styled with plain colours (no sprite sheet). The bar is
   the draggable knob; the track is the rail. Proves <input type="range" data-value>. */
.devui-val {
    color: #8ab4f8;
    margin-left: 6px;
}

input.range {
    width: 160px;
    height: 16px;
    vertical-align: -4px;
}

input.range slidertrack {
    height: 6px;
    margin-top: 5px;
    background-color: #333333;
    border: 1px #555555;
}

input.range sliderbar {
    width: 12px;
    height: 16px;
    margin-top: -5px;
    background-color: #8ab4f8;
}

input.range sliderbar:hover {
    background-color: #cccfee;
}

input.range sliderbar:active {
    background-color: #ffffff;
}

/* Composite colour picker. The SV square is a hue-tinted horizontal gradient (white ->
   pure hue, set from C++) under a transparent->black vertical overlay; the hue strip is a
   rainbow linear-gradient. drag:drag on the interactive surfaces + their children so a
   drag starts anywhere; the C++ handler maps mouse pos to S/V or H. */
/* Target selector — a row of live swatches; click to choose which colour the picker
   edits. The active one's border is set white from C++ (picker_apply). */
.pk-targets {
    display: block;
    margin-bottom: 6px;
}

.pk-target {
    display: inline-block;
    width: 34px;
    height: 22px;
    margin-right: 4px;
    border: 2px #555555;
    background-color: #000000;
    color: #000000;
    font-size: 11px;
    text-align: center;
}

.pk-wrap {
    display: block;
    margin-bottom: 6px;
}

.pk-sv {
    display: inline-block;
    position: relative;
    width: 160px;
    height: 120px;
    margin-right: 8px;
    drag: drag;
    decorator: horizontal-gradient(#ffffff #ff0000);   /* hue tint overwritten by C++ */
}

.pk-sv-val {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    drag: drag;
    decorator: vertical-gradient(#00000000 #000000ff);  /* transparent -> black = value */
}

.pk-thumb {
    position: absolute;
    width: 9px;
    height: 9px;
    margin-left: -4px;
    margin-top: -4px;
    border: 1px #ffffff;
    background-color: #00000000;
    drag: drag;
}

.pk-hue {
    display: inline-block;
    position: relative;
    width: 18px;
    height: 120px;
    vertical-align: top;
    drag: drag;
    decorator: linear-gradient(180deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);
}

.pk-hue-thumb {
    position: absolute;
    left: -2px;
    width: 22px;
    height: 3px;
    margin-top: -1px;
    border: 1px #ffffff;
    background-color: #00000000;
    drag: drag;
}

.pk-swatch {
    display: inline-block;
    width: 24px;
    height: 16px;
    vertical-align: -3px;
    margin-right: 8px;
    border: 1px #888888;
    background-color: #ffffff;
}

.pk-label {
    color: #999999;
    margin-right: 3px;
}

.pk-revert:hover {
    border-color: #ffffff;
    cursor: pointer;
}

/* <select> for the theme/text colour list. Plain colours (no sprite sheet); the dropdown
   (selectbox) scrolls since there are many names. */
select {
    width: 210px;
    height: 19px;
    vertical-align: -4px;
}

select selectvalue {
    width: auto;
    margin-right: 18px;
    padding: 1px 4px 0px 4px;
    background-color: #141414;
    border: 1px #555555;
    color: #dddddd;
}

select selectarrow {
    width: 16px;
    height: 19px;
    background-color: #333333;
    border: 1px #555555;
}

select selectarrow:hover {
    background-color: #444444;
}

select selectbox {
    margin-left: 1px;
    width: 208px;
    max-height: 240px;
    overflow-y: auto;
    padding: 2px;
    background-color: #1e1e1e;
    border: 1px #555555;
}

select selectbox option {
    padding: 1px 4px;
    color: #dddddd;
}

select selectbox option:hover,
select selectbox option:checked {
    background-color: #2a4566;
}
