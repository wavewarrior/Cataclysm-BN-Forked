/* Tier 8 — RmlUi dev-panel preview styling. An opaque box pinned top-left so it doesn't
   fight the ImGui F4 window. Interactive doc (mouse).

   IMPORTANT — authored in PX, NOT dp/em-on-dp. `ui_scale()` multiplies the context-wide
   density-independent-pixel ratio (rmlui_layer SetDensityIndependentPixelRatio), so every
   `dp` unit in every doc scales with it. The dev panel hosts the UI-scale slider itself, so
   if it scaled too it would reflow under the cursor as you drag (unusable). `px` is raw
   pixels — immune to the dp ratio — so the panel stays a fixed size while the slider
   rescales the rest of the UI. (em here resolves against a px font-size, so it is stable
   too; vh is viewport-relative, also independent of ui_scale.) */

body {
    width: 100%;
    height: 100%;
}

.devui-panel {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 320px;
    max-height: 92vh;        /* 35 rows can exceed the screen — scroll inside the box */
    overflow-y: auto;
    padding: 12px;
    background-color: #1e1e1ef0;
    border: 1px #555555;
    color: #dddddd;
    font-size: 15px;
}

.devui-title {
    font-size: 17px;
    color: #ffffff;
    margin-bottom: 8px;
}

.devui-section {
    color: #8ab4f8;
    margin-top: 10px;
    margin-bottom: 3px;
}

.devui-row {
    display: block;
    margin-bottom: 2px;
}

input.checkbox {
    width: 16px;
    height: 16px;
    border: 1px #888888;
    background-color: #141414;
    vertical-align: -3px;
    margin-right: 6px;
}

input.checkbox:hover {
    border-color: #cccccc;
}

input.checkbox:checked {
    background-color: #5fdd5f;
    border-color: #5fdd5f;
}

/* Range slider — sub-elements styled with plain colours (no sprite sheet). The bar is
   the draggable knob; the track is the rail. Proves <input type="range" data-value>. */
.devui-val {
    color: #8ab4f8;
    margin-left: 6px;
}

input.range {
    width: 160px;
    height: 16px;
    vertical-align: -4px;
}

input.range slidertrack {
    height: 6px;
    margin-top: 5px;
    background-color: #333333;
    border: 1px #555555;
}

input.range sliderbar {
    width: 12px;
    height: 16px;
    margin-top: -5px;
    background-color: #8ab4f8;
}

input.range sliderbar:hover {
    background-color: #cccfee;
}

input.range sliderbar:active {
    background-color: #ffffff;
}

/* Composite colour picker. The SV square is a hue-tinted horizontal gradient (white ->
   pure hue, set from C++) under a transparent->black vertical overlay; the hue strip is a
   rainbow linear-gradient. drag:drag on the interactive surfaces + their children so a
   drag starts anywhere; the C++ handler maps mouse pos to S/V or H. */
/* Target selector — a row of live swatches; click to choose which colour the picker
   edits. The active one's border is set white from C++ (picker_apply). */
.pk-targets {
    display: block;
    margin-bottom: 6px;
}

.pk-target {
    display: inline-block;
    width: 34px;
    height: 22px;
    margin-right: 4px;
    border: 2px #555555;
    background-color: #000000;
    color: #000000;
    font-size: 11px;
    text-align: center;
}

.pk-wrap {
    display: block;
    margin-bottom: 6px;
}

.pk-sv {
    display: inline-block;
    position: relative;
    width: 160px;
    height: 120px;
    margin-right: 8px;
    drag: drag;
    decorator: horizontal-gradient(#ffffff #ff0000);   /* hue tint overwritten by C++ */
}

.pk-sv-val {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    drag: drag;
    decorator: vertical-gradient(#00000000 #000000ff);  /* transparent -> black = value */
}

.pk-thumb {
    position: absolute;
    width: 9px;
    height: 9px;
    margin-left: -4px;
    margin-top: -4px;
    border: 1px #ffffff;
    background-color: #00000000;
    drag: drag;
}

.pk-hue {
    display: inline-block;
    position: relative;
    width: 18px;
    height: 120px;
    vertical-align: top;
    drag: drag;
    decorator: linear-gradient(180deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);
}

.pk-hue-thumb {
    position: absolute;
    left: -2px;
    width: 22px;
    height: 3px;
    margin-top: -1px;
    border: 1px #ffffff;
    background-color: #00000000;
    drag: drag;
}

.pk-swatch {
    display: inline-block;
    width: 24px;
    height: 16px;
    vertical-align: -3px;
    margin-right: 4px;
    border: 1px #888888;
    background-color: #ffffff;
}
