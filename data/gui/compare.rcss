/* game::compare two-pane item comparison (Tier 3 follower). Palette/border/
   scrollbar/.scroll-pane come from theme.rcss (linked first). Lines are
   display:block (RmlUi divs default to inline — theme.rcss gotcha). */
body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.cmp-panel {
    width: 92%;
    height: 92%;
    display: flex;
    flex-direction: row;
}

/* Two equal panes side-by-side, gap between. */
.cmp-pane {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}
.cmp-pane:first-child {
    margin-right: 8dp;
}

.cmp-title {
    flex: 0 0 auto;
    color: {{fg0}};
    margin-bottom: 6dp;
    padding-bottom: 4dp;
    border-bottom: 1dp {{bg4}};
}

.cmp-info {
    flex: 1;
    min-height: 0;
}
.cmp-line {
    display: block;
    white-space: pre-wrap;
}
