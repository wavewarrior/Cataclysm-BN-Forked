<rml>
<head>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="veh_interact.rcss"/>
</head>
<body data-model="veh_interact">
    <!-- §8.1 gate-blocker backlog: the vehicle interaction screen
         (veh_interact). THE GIANT — migrated in slices. SLICE 1 renders only the
         two zero-dependency panes: the vehicle NAME line + the action MODE bar.
         Later slices add the number panes (stats / overview), the part list +
         message pane (need vehicle.cpp text producers), the 2D vehicle diagram,
         and the install/repair sub-mode panes. Render-only: the keyboard owns
         every vehicle action. Toggle default OFF — this is scaffold + 2 panes,
         not yet a full A/B of the screen. -->
    <div class="panel vi-panel">
        <div class="vi-name" data-rml="name_rml"></div>
        <div class="vi-body">
            <div class="vi-col">
                <div id="vi-diagram" class="vi-diagram">
                    <div class="vi-diag-row" data-for="r : diagram_rows" data-rml="r.text"></div>
                </div>
                <div id="vi-parts" class="vi-parts scroll-pane" data-rml="parts_rml"></div>
            </div>
            <div class="vi-col vi-col-mid">
                <div class="vi-stats" data-rml="stats_rml"></div>
            </div>
            <div class="vi-col vi-col-right">
                <!-- normal mode: parts overview + descriptions/message -->
                <div class="vi-mode-overview" data-if="show_overview">
                    <div id="vi-overview" class="vi-overview scroll-pane">
                        <div class="vi-ov-row" data-for="r : overview_rows"
                             data-class-header="r.is_header" data-class-selected="r.selected"
                             data-event-click="on_overview(it_index)"
                             data-event-mouseover="on_overview_hover(it_index)">
                            <span class="vi-ov-text" data-rml="r.text"></span>
                            <span class="vi-ov-detail" data-rml="r.detail"></span>
                        </div>
                    </div>
                    <div id="vi-msg" class="vi-msg scroll-pane" data-rml="msg_rml"></div>
                </div>
                <!-- install/repair sub-mode (slice 6): vpart list + detail -->
                <div class="vi-mode-install" data-if="install_active">
                    <div class="vi-inst-tabs" data-rml="install_tabs_rml"></div>
                    <div id="vi-inst-list" class="vi-inst-list scroll-pane">
                        <div class="vi-ov-row" data-for="r : install_rows"
                             data-class-selected="r.selected"
                             data-event-click="on_install(it_index)"
                             data-event-mouseover="on_install_hover(it_index)">
                            <span class="vi-ov-text" data-rml="r.text"></span>
                        </div>
                    </div>
                    <div id="vi-inst-details" class="vi-inst-details scroll-pane"
                         data-rml="install_details_rml"></div>
                </div>
            </div>
        </div>
        <div class="vi-mode" data-rml="mode_rml"></div>
    </div>
</body>
</rml>
