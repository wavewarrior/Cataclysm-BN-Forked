/* Defense game-mode SETUP form (§8.1 backlog, slice 1). Palette/border from
   theme.rcss (linked first). Centred modal box: title + hint + a scrolling field
   list. Each row is a left column (label / section header / toggle name) and a
   right column (value + description, or On/Off). Field colours are baked into the
   bound strings via cata_text_to_rml; the selected field also takes a row accent. */
body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.gd-panel {
    width: 80%;
    height: 85%;
    display: flex;
    flex-direction: column;
}

.gd-title {
    flex: 0 0 auto;
    color: {{fg0}};
    border-bottom: 1dp {{bg4}};
    padding-bottom: 2dp;
    margin-bottom: 2dp;
}

.gd-hint {
    flex: 0 0 auto;
    margin-bottom: 4dp;
    white-space: nowrap;
}

.gd-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 2dp;
}

.gd-row {
    display: flex;
    justify-content: space-between;
    white-space: nowrap;
}

.gd-row.header {
    margin-top: 6dp;
    color: {{fg3}};
}

.gd-row.selected {
    background-color: {{bg2}};
}

.gd-detail {
    margin-left: 12dp;
}
