/* Layout for the new-character BIONICS tab (Tier 4 #4 slice 5). Identical to the
   TRAITS layout. Reuses theme .panel / .tabs / .tab / .item / .scroll-pane. */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

/* 72%, not 80/92%: the character-preview box is pinned to the right of the screen
   and its avatar is a GPU sprite drawn UNDERNEATH this document, so an opaque panel
   reaching over that box hides the sprite. A centred panel of width W has its right
   edge at (100+W)/2, so 72% ends at 86% and the box starts at ~86.7% — they never
   meet. 80% (right edge 90%) cleared the old box by 0.2% by luck; 92% covered it.
   Keep all eight tabs identical so the panel edge does not jump while tabbing.
   See nc_prepare_preview() in newcharacter_ui.cpp. */
.nc-panel {
    width: 72%;
    min-width: 720dp;
    height: 92%;
    display: flex;
    flex-direction: column;
}

.nc-tabs {
    flex: 0 0 auto;
}

.nc-tabs .tab {
    flex: 0 0 auto;
}

.nc-trait-top {
    flex: 0 0 auto;
    display: flex;
    flex-direction: row;
    padding: 6dp 8dp;
}

.nc-trait-points {
    display: block;
    flex: 0 0 auto;
    margin-right: 16dp;
}

.nc-trait-budget {
    display: block;
    flex: 0 0 auto;
    margin-right: 16dp;
}

.nc-trait-cost {
    display: block;
    flex: 1;
}

.nc-trait-cols {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

.nc-trait-col {
    flex: 1;
    min-width: 0;
    margin-right: 8dp;
}

.nc-trait-row {
    display: block;
}

.nc-trait-desc {
    flex: 0 0 auto;
    max-height: 96dp;
    overflow-y: auto;
    white-space: pre-wrap;
    padding: 6dp 8dp;
    border-top: 1dp {{bg4}};
    color: {{fg}};
}
