<rml>
<head>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="newchar_common.rcss"/>
    <link type="text/rcss" href="newcharprofession.rcss"/>
</head>
<body data-model="newcharprofession">
    <!-- Tier 4 screen #4 (new-character creator) slice 7: the PROFESSION tab
         (set_profession). Char-tab strip (PROFESSION current) + top bar (points +
         profession cost) + body split (profession list left / right column: sort +
         gender-swap + a big scrollable info buffer with items/skills/traits/bionics/
         pets/vehicle/spells/money/companions) + description footer + filter. Render-
         only doc; keyboard owns UP/DOWN (list, scroll-follow), LEFT/RIGHT (scroll
         the info buffer), CONFIRM (pick), CHANGE_GENDER, SORT, FILTER, RANDOMIZE,
         NEXT/PREV_TAB, QUIT. Tile preview not drawn in rml mode this slice. -->
    <div class="panel nc-panel">
        <div class="nc-steps">
            <div class="nc-step" data-for="t : tabs"
                 data-class-selected="t.selected" data-class-done="t.done">
                <div class="nc-step-icon" data-style-decorator="t.icon_dec"></div>
                <span class="nc-step-label" data-rml="t.name_rml"></span>
            </div>
        </div>
        <div class="nc-shell">
            <!-- Navigators. Shortcut text comes from the real binding via
                 input_context::get_desc, so it stays correct after a rebind. -->
            <div class="nc-arrow nc-arrow-prev" data-if="has_prev"
                 data-event-click="on_prev()">
                <div class="nc-arrow-glyph">&#60;</div>
                <div class="nc-arrow-key" data-rml="prev_key_rml"></div>
                <div class="nc-arrow-dest" data-rml="prev_name_rml"></div>
            </div>
            <div class="nc-arrow-spacer" data-if="!has_prev"></div>
            <div class="nc-stage">
            <div class="nc-prof-top">
                <span class="nc-prof-points" data-rml="points_rml"></span>
                <span class="nc-prof-cost" data-rml="cost_rml"></span>
                <!-- Screen-level controls, so they sit beside the other status text rather than
                     inside the per-profession info panel. The equipment toggle is a control of
                     the SCREEN, not of the selected profession, which is why it lives here and
                     not on the GEAR fact. -->
                <div class="nc-prof-eqp" data-event-click="on_gear()">
                    <span class="nc-prof-eqp-label" data-rml="eqp_btn_rml"></span>
                </div>
                <span class="nc-prof-sort" data-rml="sort_rml"></span>
            </div>
            <div class="nc-prof-body">
                <!-- Grouped card tree. Each band is a header (a focus stop, so CONFIRM on it
                     toggles the band without needing a keybinding of its own) plus a carousel
                     row holding only the VISIBLE page of cards. Bands are discovered from the
                     data — one per skill display category some profession leads with.
                     Hidden while the equipment sheet is up: the sheet takes the stage, and the
                     input loop hands it the navigation keys for exactly that reason. -->
                <div class="nc-tree" data-if="!eqp_open">
                    <!-- Expand/collapse every group. A real control rather than a hint: the
                         tree can hold six groups, and opening or shutting them one at a time
                         is the kind of chore a single affordance should absorb. Keyboard
                         parity comes from TOGGLE_ALL_GROUPS, whose binding the label prints. -->
                    <div class="nc-tree-head">
                        <div class="nc-tree-all" data-event-click="on_toggle_all()">
                            <span class="nc-tree-all-marker" data-rml="all_marker_rml"></span>
                            <span class="nc-tree-all-label" data-rml="all_label_rml"></span>
                        </div>
                    </div>
                    <div class="nc-band" data-for="b, bi : bands">
                        <div class="nc-band-head" data-class-focused="b.focused"
                             data-class-collapsed="b.collapsed"
                             data-event-click="on_band(bi)">
                            <span class="nc-band-marker" data-rml="b.marker_rml"></span>
                            <span class="nc-band-name" data-rml="b.name_rml"></span>
                            <span class="nc-band-count" data-rml="b.count_rml"></span>
                        </div>
                        <div class="nc-band-rail" data-if="!b.collapsed">
                            <div class="nc-band-pager" data-class-on="b.has_prev_page"
                                 data-event-click="on_page(bi, -1)">&#60;</div>
                            <div class="nc-band-cards">
                                <div class="nc-card" data-for="r : b.rows"
                                     data-class-selected="r.selected"
                                     data-class-chosen="r.chosen"
                                     data-event-click="on_card(bi, it_index)">
                                    <span class="nc-card-name" data-rml="r.text_rml"></span>
                                    <div class="nc-card-foot">
                                        <div class="nc-card-flags">
                                            <div class="nc-card-flag" data-for="i : r.icons"
                                                 data-style-decorator="i.dec"></div>
                                        </div>
                                        <span class="nc-card-pts" data-rml="r.cost_rml"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="nc-band-pager" data-class-on="b.has_next_page"
                                 data-event-click="on_page(bi, 1)">&#62;</div>
                        </div>
                        <!-- Floaty info panel for the profession under the cursor, inside the
                             band so it reads as part of THIS discipline. Fixed height and
                             position: changing profession moves only the notch above it. -->
                        <div class="nc-band-info" data-if="b.has_info">
                            <div class="nc-info-notches">
                                <div class="nc-info-gutter"></div>
                                <div class="nc-info-cells">
                                    <div class="nc-info-cell" data-for="r : b.rows"
                                         data-class-on="r.selected">
                                        <div class="nc-info-notch"></div>
                                    </div>
                                </div>
                                <div class="nc-info-gutter"></div>
                            </div>
                            <div class="nc-info-panel">
                                <!-- Art slot: the character portrait, which already wears the
                                     selected profession's starting kit. Ordinary document
                                     content — the avatar is drawn into its own render target
                                     and arrives as a decorator. -->
                                <div class="nc-info-art" data-if="has_portrait"
                                     data-style-decorator="portrait_dec"></div>
                                <div class="nc-info-facts">
                                    <div class="nc-fact">
                                        <div class="nc-fact-label">Skills</div>
                                        <div class="nc-fact-value" data-rml="skills_rml"></div>
                                        <div class="nc-fact-sub" data-rml="skills_sub_rml"></div>
                                    </div>
                                    <div class="nc-fact">
                                        <div class="nc-fact-label">Traits</div>
                                        <div class="nc-fact-value" data-rml="traits_rml"></div>
                                    </div>
                                    <!-- A readout, not a control: count, total weight and cash, so
                                         two kits can be compared without opening anything. The
                                         toggle that opens the sheet is in the status row, where a
                                         screen-level control belongs. -->
                                    <div class="nc-fact">
                                        <div class="nc-fact-label">Gear</div>
                                        <div class="nc-fact-value" data-rml="gear_rml"></div>
                                        <div class="nc-fact-sub" data-rml="gear_sub_rml"></div>
                                    </div>
                                    <div class="nc-chips">
                                        <div class="nc-chip" data-for="c : chips">
                                            <div class="nc-chip-icon" data-style-decorator="c.dec"></div>
                                            <span class="nc-chip-label" data-rml="c.label_rml"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="nc-info-desc">
                                    <div class="nc-info-blurb" data-rml="desc_rml"></div>
                                    <!-- The exhaustive buffer keeps its own scroll: LEFT/RIGHT
                                         still page it when the cursor sits on a header. -->
                                    <div id="nc-prof-info" class="nc-info-detail scroll-pane"
                                         data-rml="info_rml"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- ── STARTING EQUIPMENT SHEET ────────────────────────────────
                     The kit the selected profession hands over, in the Caves of Qud idiom:
                     a paper doll of body slots on the left, a collapsible category tree with
                     weight rollups on the right, carry capacity underneath. It takes the whole
                     stage rather than a fourth column of the fixed 188dp info panel, which a
                     doll plus a two-level tree cannot fit.
                     See plans/charcreation-profession-equipment.md. -->
                <div class="nc-eqp" data-if="eqp_open">
                    <div class="nc-eqp-head">
                        <span class="nc-eqp-title" data-rml="eqp_title_rml"></span>
                        <!-- Four spans, not one string: RmlUi trims a lone space between two
                             colour runs at parse time, which welded these into one word. The
                             stylesheet's margins cannot be trimmed. -->
                        <span class="nc-eqp-total" data-rml="eqp_count_rml"></span>
                        <span class="nc-eqp-total" data-rml="eqp_wt_rml"></span>
                        <span class="nc-eqp-total" data-rml="eqp_vol_rml"></span>
                        <span class="nc-eqp-total" data-rml="eqp_val_rml"></span>
                    </div>
                    <div class="nc-eqp-body">
                        <!-- Paper doll. Six rows of three cells, EVERY position emitted: a
                             junction cell draws the connecting lines and a blank holds its
                             column open, so the grid aligns by flex alone with no pixel
                             arithmetic — the same reason the info panel's notch row mirrors
                             the carousel's geometry instead of measuring it. -->
                        <div class="nc-eqp-doll">
                            <div class="nc-eqp-dollrow" data-for="dr : eqp_doll">
                                <div class="nc-eqp-cell" data-for="s : dr.cells"
                                     data-class-blank="s.blank"
                                     data-class-junction="s.junction"
                                     data-class-filled="s.filled">
                                    <!-- Junction: spine segment, rung, spine segment. Equal
                                         flex on the two segments puts the rung at the exact
                                         vertical middle, joining the box above to the box below
                                         and the left cell to the right one — no offsets. -->
                                    <div class="nc-eqp-spine" data-if="s.junction"></div>
                                    <div class="nc-eqp-rung" data-if="s.junction"></div>
                                    <div class="nc-eqp-spine" data-if="s.junction"></div>
                                    <div class="nc-eqp-slot" data-if="!s.blank && !s.junction">
                                        <div class="nc-eqp-art" data-style-decorator="s.dec"></div>
                                        <span class="nc-eqp-item" data-rml="s.item_rml"></span>
                                        <span class="nc-eqp-slotname" data-rml="s.name_rml"></span>
                                        <span class="nc-eqp-more" data-rml="s.more_rml"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Category tree. FLAT row list with level classes rather than a
                             nested data-for: collapsing is then a filter over one list, and
                             uniform row height makes scrolling the cursor into view exact
                             arithmetic instead of DOM child indexing. -->
                        <div id="nc-eqp-tree" class="nc-eqp-tree scroll-pane">
                            <div class="nc-eqp-row" data-for="r : eqp_rows"
                                 data-class-group="r.group"
                                 data-class-sub="r.sub"
                                 data-class-focused="r.focused"
                                 data-event-click="on_eqp_row(it_index)">
                                <span class="nc-eqp-marker" data-rml="r.marker_rml"></span>
                                <span class="nc-eqp-name" data-rml="r.name_rml"></span>
                                <!-- Leader rule, so a header's weight reads as belonging to it
                                     across the gap. Qud draws the same thing with dashes. -->
                                <div class="nc-eqp-leader"></div>
                                <span class="nc-eqp-stat" data-rml="r.stat_rml"></span>
                                <span class="nc-eqp-vol" data-rml="r.vol_rml"></span>
                                <span class="nc-eqp-val" data-rml="r.val_rml"></span>
                                <span class="nc-eqp-wt" data-rml="r.wt_rml"></span>
                            </div>
                        </div>
                    </div>
                    <div class="nc-eqp-foot">
                        <!-- Used / capacity as two spans with the divider as its own element,
                             for the same parse-time whitespace reason as the header totals. -->
                        <span class="nc-eqp-used" data-rml="eqp_used_rml"></span>
                        <span class="nc-eqp-slash">/</span>
                        <span class="nc-eqp-cap" data-rml="eqp_cap_rml"></span>
                        <div class="nc-eqp-bar" data-class-over="eqp_over">
                            <div class="nc-eqp-bar-fill" data-style-width="eqp_bar_w"></div>
                        </div>
                        <div class="nc-eqp-spacer"></div>
                        <span class="nc-eqp-close" data-rml="eqp_close_rml"></span>
                    </div>
                </div>
            </div>
            <!-- Key for the card strips: "sigil :: meaning", spread across the panel. Both it
                 and the filter line describe the CARD LIST, so they go away with it; the gender
                 line stays, because gender changes the kit the sheet is showing. -->
            <div class="nc-legend" data-if="!eqp_open">
                <div class="nc-legend-item" data-for="l : legend">
                    <div class="nc-legend-icon" data-style-decorator="l.dec"></div>
                    <span class="nc-legend-sep">::</span>
                    <span class="nc-legend-label" data-rml="l.label_rml"></span>
                </div>
            </div>
            <div class="nc-prof-gender" data-rml="gender_rml"></div>
            <div class="nc-prof-filter" data-if="!eqp_open" data-rml="filter_rml"></div>
            </div>
            <div class="nc-arrow nc-arrow-next" data-if="has_next"
                 data-event-click="on_next()">
                <div class="nc-arrow-glyph">&#62;</div>
                <div class="nc-arrow-key" data-rml="next_key_rml"></div>
                <div class="nc-arrow-dest" data-rml="next_name_rml"></div>
            </div>
            <div class="nc-arrow-spacer" data-if="!has_next"></div>
        </div>
        <div class="nc-exit" data-rml="exit_rml"></div>
    </div>
    <div id="crt-overlay" class="crt"></div>
</body>
</rml>
