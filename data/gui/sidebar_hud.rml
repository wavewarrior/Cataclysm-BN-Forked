<rml>
<head>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="sidebar_hud.rcss"/>
</head>
<body data-model="sidebar_hud">
    <!-- Full Qud-inspired layout: top bar (1 row), vitals overlay (top-left),
         dock (minimap + log, right edge), bottom strips (botbar + hotbar, 2 rows).
         All regions are absolutely positioned; the sidebar width is carved from
         the viewport edge. No dynamic row iteration — fixed data-model strings. -->

    <!-- Top bar: full viewport width, 1 row -->
    <div id="hud-topbar" class="runic-edge-bottom runic-no-top">
        <div class="hud-strip-row" data-rml="topbar_rml"></div>
    </div>

    <!-- Vitals overlay: chunky HP bars floating over the map, top-left -->
    <div id="hud-vitals">
        <div class="hud-vitals-inner" data-rml="vitals_rml"></div>
    </div>

    <!-- Dock: minimap + log stacked vertically at the sidebar edge -->
    <div id="hud-dock" class="runic-region runic-no-right">
        <div class="dock-section">
            <div class="dock-header" data-rml="minimap_title"></div>
            <div class="dock-body hud-map-body" data-rml="minimap_rml"></div>
        </div>
        <div class="dock-section dock-flex">
            <div class="dock-header" data-rml="log_title"></div>
            <div id="hud-log-body" class="dock-body hud-scroll" data-rml="log_rml"></div>
        </div>
    </div>

    <!-- Bottom bar: effects/target/weapon info -->
    <div id="hud-botbar" class="runic-edge-top runic-no-bottom">
        <div class="hud-strip-row" data-rml="botbar_rml"></div>
    </div>

    <!-- Hotbar: keybind slots -->
    <div id="hud-hotbar">
        <div class="hud-strip-row" data-rml="hotbar_rml"></div>
    </div>
    <!-- Damage vignette overlay: radial red gradient at edges, fades in/out -->
    <div id="hud-vignette"></div>
</body>
</rml>