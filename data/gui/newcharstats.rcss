/* Layout for the new-character STATS tab (Tier 4 #4 slice 2). Reuses theme
   .panel / .tabs / .tab / .item / .scroll-pane. body sized + centered (the
   missions gotcha); rows need explicit display (the inline-row gotcha). */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

/* 72%, not 80/92%: the character-preview box is pinned to the right of the screen
   and its avatar is a GPU sprite drawn UNDERNEATH this document, so an opaque panel
   reaching over that box hides the sprite. A centred panel of width W has its right
   edge at (100+W)/2, so 72% ends at 86% and the box starts at ~86.7% — they never
   meet. 80% (right edge 90%) cleared the old box by 0.2% by luck; 92% covered it.
   Keep all eight tabs identical so the panel edge does not jump while tabbing.
   See nc_prepare_preview() in newcharacter_ui.cpp. */
.nc-panel {
    width: 72%;
    min-width: 720dp;
    height: 92%;
    display: flex;
    flex-direction: column;
}

.nc-tabs {
    flex: 0 0 auto;
}

.nc-tabs .tab {
    flex: 0 0 auto;
}

.nc-points {
    display: block;
    flex: 0 0 auto;
    padding: 8dp;
    color: {{fg}};
}

.nc-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

.nc-stats-left {
    flex: 0 0 auto;
    min-width: 320dp;
    display: flex;
    flex-direction: column;
    border-right: 1dp {{bg4}};
    padding-right: 8dp;
}

.nc-stats {
    display: block;
    flex: 0 0 auto;
    margin-bottom: 16dp;
}

/* One stat per line: label (fixed-width column) + right-aligned value. */
.nc-stat {
    display: flex;
    flex-direction: row;
}

.nc-stat-name {
    display: block;
    flex: 0 0 auto;
    min-width: 160dp;
}

.nc-stat-val {
    display: block;
    flex: 1;
    text-align: right;
}

.nc-hints {
    display: block;
    flex: 1;
    min-height: 0;
    white-space: pre-wrap;
    color: {{fg}};
}

.nc-stats-right {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding-left: 8dp;
}

.nc-cost {
    display: block;
    flex: 0 0 auto;
    margin-bottom: 8dp;
}

.nc-desc {
    flex: 1;
    min-height: 0;
    white-space: pre-wrap;
    color: {{fg}};
}
