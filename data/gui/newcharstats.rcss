/* Layout for the new-character STATS tab (Tier 4 #4 slice 2). Reuses theme
   .panel / .tabs / .tab / .item / .scroll-pane. body sized + centered (the
   missions gotcha); rows need explicit display (the inline-row gotcha). */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

/* 98%: creation fills the screen, with the remaining 1% each side keeping the panel's
   own border visible as a frame instead of running off the display edge. These four
   tabs have no character preview, so nothing sits outside the panel to be occluded.
   The four preview tabs stay narrow until the avatar composites through RmlUi — see
   plans/charcreation-wizard-flow.md. */
.nc-panel {
    width: 98%;
    height: 98%;
    display: flex;
    flex-direction: column;
}

.nc-steps {
    flex: 0 0 auto;
}

.nc-step {
    flex: 0 0 auto;
}

.nc-points {
    display: block;
    flex: 0 0 auto;
    padding: 8dp;
    color: {{fg}};
}

.nc-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

.nc-stats-left {
    flex: 0 0 auto;
    min-width: 320dp;
    display: flex;
    flex-direction: column;
    border-right: 1dp {{bg4}};
    padding-right: 8dp;
}

.nc-stats {
    display: block;
    flex: 0 0 auto;
    margin-bottom: 16dp;
}

/* One stat per line: label (fixed-width column) + right-aligned value. */
.nc-stat {
    display: flex;
    flex-direction: row;
}

.nc-stat-name {
    display: block;
    flex: 0 0 auto;
    min-width: 160dp;
}

.nc-stat-val {
    display: block;
    flex: 1;
    text-align: right;
}

.nc-hints {
    display: block;
    flex: 1;
    min-height: 0;
    white-space: pre-wrap;
    color: {{fg}};
}

.nc-stats-right {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding-left: 8dp;
}

.nc-cost {
    display: block;
    flex: 0 0 auto;
    margin-bottom: 8dp;
}

.nc-desc {
    flex: 1;
    min-height: 0;
    white-space: pre-wrap;
    color: {{fg}};
}
