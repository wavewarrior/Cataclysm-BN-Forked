<rml>
<head>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="newchar_common.rcss"/>
    <link type="text/rcss" href="newcharpoints.rcss"/>
</head>
<body data-model="newcharpoints">
    <!-- Tier 4 screen #4 (new-character creator) slice 1: the POINTS tab
         (set_points). Character-tab strip (8 steps, render-only — tab nav is
         keyboard NEXT_TAB/PREV_TAB) + the points line + the point-pool option
         list (cursor = .selected; chosen pool baked green into the text) + a
         description pane for the highlighted option. Render-only doc; keyboard
         still owns UP/DOWN/CONFIRM/NEXT_TAB/PREV_TAB/QUIT. -->
    <div class="panel nc-panel">
        <div class="nc-steps">
            <div class="nc-step" data-for="t : tabs"
                 data-class-selected="t.selected" data-class-done="t.done">
                <div class="nc-step-icon" data-style-decorator="t.icon_dec"></div>
                <span class="nc-step-label" data-rml="t.name_rml"></span>
            </div>
        </div>
        <div class="nc-shell">
            <!-- Navigators. Shortcut text comes from the real binding via
                 input_context::get_desc, so it stays correct after a rebind. -->
            <div class="nc-arrow nc-arrow-prev" data-if="has_prev"
                 data-event-click="on_prev()">
                <div class="nc-arrow-glyph">&#60;</div>
                <div class="nc-arrow-key" data-rml="prev_key_rml"></div>
                <div class="nc-arrow-dest" data-rml="prev_name_rml"></div>
            </div>
            <div class="nc-arrow-spacer" data-if="!has_prev"></div>
            <div class="nc-stage nc-stage-centred">
                <div class="nc-title-block">
                    <div class="nc-title">character creation</div>
                    <div class="nc-subtitle">: choose point pool :</div>
                </div>
                <div class="nc-points" data-rml="points_rml"></div>
                <!-- One card per available pool. The count is data-driven, NOT always
                     three: CHARACTER_POINT_POOLS yields 1 (multi_pool), 2 (no_freeform)
                     or 3, so the row is centred and the cards are fixed-width rather
                     than stretched, which would make a single card fill the screen. -->
                <div class="nc-cards">
                    <div class="nc-card" data-for="o : opts"
                         data-class-selected="o.selected" data-class-chosen="o.chosen"
                         data-event-click="on_card(it_index)">
                        <div class="nc-card-art" data-style-decorator="o.rune_dec"></div>
                        <div class="nc-card-info">
                            <div class="nc-card-name" data-rml="o.name_rml"></div>
                            <div class="nc-card-text" data-rml="o.info_rml"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="nc-arrow nc-arrow-next" data-if="has_next"
                 data-event-click="on_next()">
                <div class="nc-arrow-glyph">&#62;</div>
                <div class="nc-arrow-key" data-rml="next_key_rml"></div>
                <div class="nc-arrow-dest" data-rml="next_name_rml"></div>
            </div>
            <div class="nc-arrow-spacer" data-if="!has_next"></div>
        </div>
        <div class="nc-exit" data-rml="exit_rml"></div>
    </div>
    <div id="crt-overlay" class="crt"></div>
</body>
</rml>
