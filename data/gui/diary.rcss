/* Layout for the diary screen (Tier 1, screen #6: diary::show_diary_ui).
   Palette/border/scrollbar/.scroll-pane come from theme.rcss (linked first in
   diary.rml); this file owns only the screen's own layout. Lengths in dp.

   Both missions gotchas apply (documented in uilist.rcss): body needs a definite
   height or the panel shrink-wraps; each scroll list carries .scroll-pane's vh
   max-height (the actual scroll bound).

   KEY DIFFERENCE vs the toggle-list screens: the rows do NOT use theme's .item
   (whose .selected is always the accent). The diary highlights the selected row
   ONLY in the active pane (legacy gated the hilite on print_list_scrollable's
   `active` flag), so .diary-line owns its own states and the selected-row accent
   is scoped under .diary-pane.active. */
body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.diary-panel {
    width: 90%;
    height: 90%;
    display: flex;
    flex-direction: column;
}

/* "<owner>'s Diary" */
.diary-title {
    flex: 0 0 auto;
    text-align: center;
    color: #ffcc66ff;
    margin-bottom: 4dp;
}

/* keybinding hints (New page / Edit text / Delete page / Export diary) */
.diary-desc {
    flex: 0 0 auto;
    text-align: center;
    color: #9a9ab0ff;
    padding-bottom: 6dp;
    margin-bottom: 6dp;
    border-bottom: 1dp #5a5a78ff;
}

/* The three side-by-side scroll lists. */
.diary-main {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

/* Each pane gets a thin border that brightens to the accent when it has focus
   (the active pane), so the player can see which list LEFT/RIGHT moved to. */
.diary-pane {
    border: 1dp #5a5a78ff;
    border-radius: 4dp;
    margin: 0 4dp;
}
.diary-pane.active {
    border-color: #ffcc66ff;
}

.diary-pages {
    flex: 0 0 22%;
}
.diary-changes {
    flex: 1;
}
.diary-text {
    flex: 1.4;
    white-space: pre-wrap;
}

/* A single list row. display:block so each is its own line — RmlUi elements
   default to inline (the bundled div{display:block} lives in the sample rml.rcss
   we don't link), and .diary-pane is a .scroll-pane block container, not a
   flex-column, so without this the rows flow horizontally as one paragraph.
   Transparent by default; hover always lightly highlights, but the selected-row
   accent applies ONLY inside the active pane (see header). */
.diary-line {
    display: block;
    padding: 2dp 6dp;
    border-radius: 4dp;
}
.diary-line:hover {
    background-color: #3a3a55ff;
    color: #ffffffff;
}
.diary-pane.active .diary-line.selected {
    background-color: #ffcc66ff;
    color: #1e1e28ff;
}

/* Bottom info pane: description of the selected change. */
.diary-info {
    flex: 0 0 auto;
    margin-top: 6dp;
    padding-top: 6dp;
    border-top: 1dp #5a5a78ff;
    min-height: 40dp;
    color: #cfcfe0ff;
}
