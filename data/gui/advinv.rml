<rml>
<head>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="advinv.rcss"/>
</head>
<body data-model="advinv">
    <!-- Tier 3 sub-project (advanced inventory / AIM). SLICE 1: dual-pane item lists
         + weight/vol heads. SLICE 2: top bar (clock + keybinding/reset-filter hints)
         + per-pane area-selection grid (semantic compass 3x3 + specials, coloured by
         state). DEFERRED: message log + minimap (slice 3), footer + filter/examine/
         move feedback + AIM_ALL src + compact (slice 3). Keyboard owns all input. -->
    <div class="panel aim-outer">
        <div class="aim-topbar">
            <span class="aim-clock" data-rml="clock_rml"></span>
            <span class="aim-hints" data-rml="hints_rml"></span>
        </div>
        <div class="aim-root">
            <div class="aim-pane">
                <div class="aim-phead">
                    <span class="aim-title" data-rml="left_title_rml"></span>
                    <span class="aim-cap" data-rml="left_head_rml"></span>
                </div>
                <div class="aim-areagrid" data-rml="left_grid_rml"></div>
                <div class="aim-list scroll-pane" data-rml="left_rows_html"></div>
            </div>
            <div class="aim-pane">
                <div class="aim-phead">
                    <span class="aim-title" data-rml="right_title_rml"></span>
                    <span class="aim-cap" data-rml="right_head_rml"></span>
                </div>
                <div class="aim-areagrid" data-rml="right_grid_rml"></div>
                <div class="aim-list scroll-pane" data-rml="right_rows_html"></div>
            </div>
        </div>
    </div>
</body>
</rml>
