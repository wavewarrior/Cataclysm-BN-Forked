/* Layout for the mouse-hover tile tooltip (P3 track-A: live_view). Palette/border/
   scrollbar/.scroll-pane come from theme.rcss (linked first in live_view.rml);
   this file owns only the box's own layout. Lengths in dp.

   A single absolutely-positioned box (the curses tooltip sat at the top sidebar
   edge, sidebar-width). C++ sets #lv-box left/top/width each sync to track the
   sidebar rect; the height auto-sizes to its content and is capped at half the
   screen (mirrors the curses max_height = TERMY/2). A centered "< Mouse View >"
   title over the tile-info pane. Per-segment colour baked via cata_text_to_rml. */
.lv-box {
    position: absolute;
    display: flex;
    flex-direction: column;
    max-height: 50%;
    background-color: {{bg}};
    border: 1dp {{bg4}};
    padding: 2dp 4dp;
}

.lv-title {
    flex: 0 0 auto;
    text-align: center;
    color: {{fg}};
    border-bottom: 1dp {{bg4}};
    padding-bottom: 1dp;
    margin-bottom: 1dp;
    white-space: nowrap;
}

.lv-info {
    flex: 1 1 0;
    min-height: 0;
    white-space: pre-wrap;
    color: {{fg}};
}
