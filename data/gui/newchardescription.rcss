/* Layout for the new-character OVERVIEW tab (Tier 4 #4 slice 8). Reuses theme
   .panel / .tabs / .tab / .item / .scroll-pane. The six summary panes flow in a
   wrapping row; each scrolls independently. */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

/* 72%, not 80/92%: the character-preview box is pinned to the right of the screen
   and its avatar is a GPU sprite drawn UNDERNEATH this document, so an opaque panel
   reaching over that box hides the sprite. A centred panel of width W has its right
   edge at (100+W)/2, so 72% ends at 86% and the box starts at ~86.7% — they never
   meet. 80% (right edge 90%) cleared the old box by 0.2% by luck; 92% covered it.
   Keep all eight tabs identical so the panel edge does not jump while tabbing.
   See nc_prepare_preview() in newcharacter_ui.cpp. */
.nc-panel {
    width: 98%;
    height: 98%;
    display: flex;
    flex-direction: column;
}

.nc-steps {
    flex: 0 0 auto;
}

.nc-step {
    flex: 0 0 auto;
}

.nc-desc-points {
    display: block;
    flex: 0 0 auto;
    padding: 4dp 8dp;
}

.nc-desc-editrow {
    flex: 0 0 auto;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 2dp 8dp;
    border-bottom: 1dp {{bg4}};
}

.nc-desc-sp {
    flex: 0 0 auto;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 2dp 8dp;
}

.nc-desc-field {
    display: block;
    margin-right: 24dp;
    white-space: pre;
}

.nc-desc-panes {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4dp 8dp;
}

/* Six panes separated only by x-position read as one field of text. A hairline
   rule plus a real gutter gives the eye a group boundary; the first pane skips the
   rule so the row does not open with a stray edge. The header inside each pane is
   baked into its data-rml string and cannot be styled from here — see
   plans/charcreation-visual-overhaul.md workstream 4. */
.nc-desc-pane {
    flex: 1;
    min-width: 180dp;
    min-height: 0;
    margin: 0 0 8dp 0;
    padding: 0 14dp;
    border-left: 1dp {{bg4}};
    /* Column is now head + scrolling body, not one text blob. */
    display: flex;
    flex-direction: column;
}

.nc-desc-pane:first-child {
    border-left-color: transparent;
    padding-left: 0;
}

/* Static keybinding help. 110dp fitted only 5 of the 7 lines, clipping the last
   one mid-glyph and pushing the rest behind a scrollbar — help text you have to
   scroll is help text you don't read, and there is ample empty space above it.
   The cap is kept (generously) so a long translation degrades to scrolling
   instead of eating the panes above. */
.nc-desc-guide {
    flex: 0 0 auto;
    max-height: 200dp;
    overflow-y: auto;
    white-space: pre-wrap;
    padding: 6dp 8dp;
    border-top: 1dp {{bg4}};
    /* Dimmer than the character data above it: this is standing reference text,
       not content, and at full strength it competed with the panes. The keybinding
       glyphs keep their baked yellow, so the scannable part still stands out. */
    color: {{fg4}};
}

/* Portrait box. The avatar texture is AVATAR_TARGET_PX square and `contain` keeps its
   aspect, so this only decides how much room the sprite gets. Anchored top-right of the
   stage, which is where the old floating preview sat — but now it is inside the panel,
   which is what let the panel grow to 98%. */
.nc-portrait {
    /* `position: absolute` here resolves against .nc-panel, NOT against .nc-stage —
       measured earlier in this work when a beam anchored to a `position: relative`
       parent landed against the panel instead. That behaviour is exactly the placement
       wanted here (panel top-right), so it is relied on deliberately rather than by
       accident. top/right clear the step rail and the panel's 24dp runic-frame inset. */
    position: absolute;
    right: 32dp;
    top: 52dp;
    width: 208dp;
    height: 208dp;
}
