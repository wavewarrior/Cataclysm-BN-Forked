/* Layout for the new-character OVERVIEW tab (Tier 4 #4 slice 8).
   Linked AFTER newchar_common.rcss, so a same-specificity rule here wins.

   ROW based, the shared row-list vocabulary (newchar_common.rcss) plus this step's own identity
   cells and the record seal. See plans/charcreation-overview-seal.md. */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.nc-panel {
    width: 98%;
    height: 98%;
    display: flex;
    flex-direction: column;
}

.nc-steps {
    flex: 0 0 auto;
}

.nc-step {
    flex: 0 0 auto;
}

/* ── COLUMN WIDTHS ────────────────────────────────────────────────────────────
   Four columns of equal width put the longest values on this screen — a character name, a gender
   pair, a location — in the narrowest useful space, and they clipped. The identity column takes half
   again what a record column does; the record columns share what is left equally. */
.nc-ident-col {
    flex: 3;
}

.nc-rec-col {
    flex: 2;
}

/* ── IDENTITY CELLS ───────────────────────────────────────────────────────────
   The five editable fields. Fixed-width label and a flexible value, so the labels form one column
   and the values another — the same alignment argument every other row list in the creator makes.
   The cursor cell, the steppers and the row itself are shared rules. */
.nc-ident-label {
    display: block;
    flex: 0 0 auto;
    width: 92dp;
    white-space: nowrap;
    overflow: hidden;
}

.nc-ident-val {
    display: block;
    flex: 1;
    min-width: 0;
    /* LOAD-BEARING, as on every other list: a value wrapping to a second line spills into the row
       below, and it grows the list's scroll height, which desyncs anything measuring rows. */
    white-space: nowrap;
    overflow: hidden;
}

/* The edit affordance. Present on all five fields — two of the editors are modal, and a row click
   only ever moves the cursor, so every field needs a control that means "change this". */
.nc-ident-edit {
    display: block;
    flex: 0 0 auto;
    width: 20dp;
    text-align: center;
    color: {{fg4}};
}

.nc-ident-edit:hover {
    color: {{yellow}};
}

/* ── RECORD ROWS ──────────────────────────────────────────────────────────────
   The read-only digest. A name that flexes and a right-aligned value, so the numbers in the
   ATTRIBUTES column stack into a gutter the eye can run down. Most rows have no value at all (a
   trait name, an item), which is why the value cell is not reserved a fixed width. */
.nc-cell-val {
    display: block;
    flex: 0 0 auto;
    text-align: right;
    margin-left: 8dp;
    color: {{fg0}};
}

/* ── RECORD SEAL ──────────────────────────────────────────────────────────────
   A ring of the seven earlier steps, welded shut once per cycle. Same 13x13 dot lattice as the
   SKILLS aptitude radar, and for the same reason: a circle on a square grid needs no transform and
   nothing positioned, and `position: absolute` in these documents resolves against .nc-panel rather
   than the intended parent (see the balance scale in newchar_common.rcss). */
.nc-seal-wrap {
    flex: 0 0 auto;
    width: 196dp;
    display: flex;
    flex-direction: column;
}

/* Square: 13 flex rows of 13 flex cells inside a box as wide as the column. The height is fixed to
   the width so the ring cannot render as an ellipse when the stage is short. */
.nc-seal {
    flex: 0 0 auto;
    height: 196dp;
    display: flex;
    flex-direction: column;
}

.nc-seal-row {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
}

/* Thread: a SMALL round stitch inside its cell. The margin shrinks the painted box without changing
   the lattice pitch, which is what keeps the ring aligned with the nodes. A cell filling its whole
   15dp made the ring a wreath of touching blobs — and buried the node glyphs, since a node's socket
   is the same gold. */
.nc-seal-cell {
    flex: 1;
    min-width: 0;
    height: 58%;
    margin: 0 3dp;
    border-radius: 6dp;
}

/* Node: the full cell, so its step glyph has room to read against the socket. */
.nc-seal-cell.node {
    height: 100%;
    margin: 0;
    border-radius: 8dp;
}

/* ── LEGEND ───────────────────────────────────────────────────────────────────
   `.nc-tally*` are shared rules (newchar_common.rcss) — the SKILLS radar legend is the other
   consumer. Only the gap above it belongs to this step. */
.nc-tally {
    margin-top: 8dp;
}

/* ── DETAIL ───────────────────────────────────────────────────────────────────
   The shared `.nc-selname` header sits above the art | facts | prose panel; only the panel's own
   proportions are this step's business. Matches TRAITS: three facts plus prose, and a portrait that
   needs room. */
.nc-info-panel {
    height: 196dp;
}

/* The portrait is a `scale-none` window into a 512px render target, so this box does not resize the
   character — it decides how much of the target is visible. 168dp is what TRAITS settled on. */
.nc-info-art {
    width: 168dp;
    height: 168dp;
}
