/* Layout for the Colors editor (color_manager::show_gui). Palette/border/scrollbar/
   .scroll-pane and the .panel frame come from theme.rcss (linked first); this file
   owns only this screen's layout. Row/cell colours are baked into the bound strings.
   The active column on the current row gets the accent (.cellsel). Monospace so the
   columns line up. Lengths in dp. */

body {
    width: 100%;
    height: 100%;
}

.cm-panel {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.cm-header {
    flex: 0 0 auto;
    white-space: pre-wrap;
    padding-bottom: 4dp;
    margin-bottom: 4dp;
    border-bottom: 1dp {{bg4}};
}

/* Shared 3-column template so the header row and data rows line up. */
.cm-colheads {
    flex: 0 0 auto;
    display: flex;
    flex-direction: row;
    padding: 0 4dp 2dp 4dp;
    color: {{fg4}};
}

.cm-list {
    flex: 1;
    min-height: 0;
}

.cm-row {
    display: flex;
    flex-direction: row;
    padding: 0 4dp;
}

.cm-name {
    flex: 0 0 260dp;
}

.cm-normal {
    flex: 1;
    border-radius: 4dp;
}

.cm-invert {
    flex: 1;
    border-radius: 4dp;
}

.cm-custom {
    margin-left: 8dp;
}

.cellsel {
    background-color: {{yellow}};
    color: {{bg-hard}};
}
