/* Layout for the full message-log screen (§8.1 backlog: Messages::display_messages).
   Palette/border/scrollbar/.scroll-pane come from theme.rcss (linked first in
   messages.rml); this file owns only the screen's own layout. Lengths in dp.

   A vertical text pane: each .msg-line is a flex row of a fixed-width right-
   aligned time column + the wrapping message text. .msg-line is display:block /
   the row a flex container so lines stack (RmlUi divs/spans default to inline —
   see the theme.rcss gotcha). Time column is light-blue + muted, matching the
   legacy c_light_blue time_color; per-line message colour is baked into the
   bound text span via cata_text_to_rml(colorize(...)). */
body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.msg-panel {
    width: 80%;
    height: 85%;
    display: flex;
    flex-direction: column;
}

/* The scrolling log. Fills the panel above the footer. */
.msg-screen {
    flex: 1;
    min-height: 0;
}

.msg-line {
    display: flex;
    flex-direction: row;
    white-space: normal;
}

/* Right-aligned time column. Width tracks the curses time_width (~12 cols);
   fixed so the message text left-aligns into a clean second column. */
.msg-time {
    display: block;
    width: 92dp;
    flex: 0 0 92dp;
    text-align: right;
    padding-right: 8dp;
    color: {{blue}};
}

.msg-text {
    display: block;
    flex: 1;
    min-width: 0;
    white-space: pre-wrap;
}

/* Footer hint line (the "< F to filter, … >" row, or the active filter string).
   Muted, single line, separated from the log by the panel's inner border. */
.msg-footer {
    flex: 0 0 auto;
    padding: 2dp 4dp 0 4dp;
    color: {{fg4}};
    white-space: nowrap;
}
