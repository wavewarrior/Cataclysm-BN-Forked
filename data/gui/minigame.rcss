/* Tier 9 — shared minigame char-grid styling. Palette/border come from theme.rcss
   (linked first in minigame.rml). The grid is monospace (the body inherits
   "Terminus (TTF)" from theme) under white-space:pre so each cell column-aligns —
   the help Movement diagram proves cell-alignment under pre. Centred modal box. */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.mg-panel {
    display: flex;
    flex-direction: column;
    padding: 16dp;
    background-color: #1a1a1af0;
    border: 1dp #555555;
    color: #dddddd;
}

.mg-title {
    color: #ffffff;
    margin-bottom: 10dp;
}

/* The cell grid: exact monospace, no wrap, so columns line up. */
.mg-grid {
    margin-bottom: 10dp;
    white-space: pre;
}

.mg-row {
    display: block;
    white-space: pre;
}

/* Legend / keybinding hints under the grid. */
.mg-footer {
    display: block;
    white-space: pre-wrap;
    color: #b0b0b0;
}
