/* Layout for the safe mode manager (Tier 2, screen #3: safemode::show).
   Palette/border/scrollbar/.scroll-pane AND the .tabs/.tab bar come from
   theme.rcss (linked first in safemode.rml); this file owns only the screen's own
   layout. Lengths in dp.

   The 6-column template (.sm-num/.sm-rule/.sm-att/.sm-dist/.sm-wb/.sm-cat) is
   shared between the column-head row and the data rows so they line up (mirrors
   the legacy fixed column_pos offsets). Rows are .sm-row flex containers (so they
   are block-level and stack); the active CELL — not the row — gets the accent,
   via .sm-cell.cellsel (driven by row.sel_col == <col> in the rml). */
body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.sm-panel {
    width: 88%;
    height: 90%;
    display: flex;
    flex-direction: column;
}

/* Hotkey hints + safe-mode-enabled status. */
.sm-hints {
    flex: 0 0 auto;
}
.sm-status {
    flex: 0 0 auto;
    margin-bottom: 4dp;
}

/* Static column titles; same 6-column template as the rows (sans row bg). */
.sm-colheads {
    flex: 0 0 auto;
    display: flex;
    flex-direction: row;
    padding: 0 6dp 4dp 6dp;
    border-bottom: 1dp #5a5a78ff;
    color: #9a9ab0ff;
}

.sm-empty {
    flex: 1;
    padding: 8dp 6dp;
}

.sm-list {
    flex: 1;
    min-height: 0;
}

/* A single rule row — flex container (block-level → stacks vertically). */
.sm-row {
    display: flex;
    flex-direction: row;
    padding: 2dp 6dp;
    border-radius: 4dp;
}
.sm-row:hover {
    background-color: #3a3a55ff;
}

/* The active cell (cursor line + cursor column) gets the accent. */
.sm-cell.cellsel {
    background-color: #ffcc66ff;
    color: #1e1e28ff;
    border-radius: 2dp;
}

/* Shared 6-column template (used by .sm-colheads and .sm-row). */
.sm-num {
    flex: 0 0 40dp;
}
.sm-rule {
    flex: 1;
}
.sm-att {
    flex: 0 0 130dp;
}
.sm-dist {
    flex: 0 0 70dp;
    text-align: center;
}
.sm-wb {
    flex: 0 0 110dp;
}
.sm-cat {
    flex: 0 0 90dp;
}
