/* Advanced inventory (AIM) dual-pane (Tier 3 sub-project, slice 1). Palette/border/
   scrollbar/.scroll-pane/.panel from theme.rcss. Rows/cells are display:flex columns
   (RmlUi divs default to inline — theme.rcss gotcha) so amt/weight/vol align without
   absolute positions. */
body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.aim-outer {
    width: 96%;
    height: 94%;
    display: flex;
    flex-direction: column;
}
/* Top bar: clock left, keybinding/reset-filter hints right. */
.aim-topbar {
    flex: 0 0 auto;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4dp;
    padding-bottom: 4dp;
    border-bottom: 1dp #7c6f64ff;
}
.aim-clock {
    color: #fbf1c7ff;
}
.aim-hints {
    color: #a89984ff;
    text-align: right;
}
.aim-root {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

/* Two equal panes; a divider between them. */
.aim-pane {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}
.aim-pane:first-child {
    margin-right: 6dp;
    padding-right: 6dp;
    border-right: 1dp #7c6f64ff;
}

/* Pane header: area name left, weight/volume capacity right. */
.aim-phead {
    flex: 0 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4dp;
    padding-bottom: 4dp;
    border-bottom: 1dp #7c6f64ff;
}
.aim-title {
    color: #fbf1c7ff;
}
.aim-cap {
    color: #a89984ff;
    white-space: pre;
    text-align: right;
}

.aim-list {
    flex: 1;
    min-height: 0;
}

/* Column-header row + item rows share the cell column geometry. */
.aim-colhead {
    display: flex;
    flex-direction: row;
    color: #a89984ff;
    border-bottom: 1dp #7c6f64ff;
    margin-bottom: 2dp;
}
.aim-row {
    display: flex;
    flex-direction: row;
    padding: 0 2dp;
    border-radius: 3dp;
}
.aim-row:hover {
    background-color: #504945ff;
}
.aim-row.selected {
    background-color: #fabd2fff;
    color: #1d2021ff;
}
.aim-cat {
    display: block;
    text-align: center;
    color: #d3869bff;
    margin-top: 2dp;
}

/* Cells: name fills, the three numeric columns are fixed-width + right-aligned. */
.aim-c-name {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
}
.aim-c-amt {
    flex: 0 0 auto;
    width: 42dp;
    text-align: right;
    white-space: pre;
}
.aim-c-wt {
    flex: 0 0 auto;
    width: 56dp;
    text-align: right;
    white-space: pre;
}
.aim-c-src {
    flex: 0 0 auto;
    width: 34dp;
    text-align: right;
    white-space: pre;
}
.aim-c-vol {
    flex: 0 0 auto;
    width: 50dp;
    text-align: right;
    white-space: pre;
}

/* Sort indicator (top of pane) + filter footer (bottom). */
.aim-sort {
    flex: 0 0 auto;
    white-space: pre;
    margin-bottom: 2dp;
}
.aim-filter {
    flex: 0 0 auto;
    white-space: pre;
    margin-top: 4dp;
    padding-top: 4dp;
    border-top: 1dp #7c6f64ff;
}

/* Area-selection grid (slice 2): semantic compass 3x3 + a specials row, right-
   aligned in the pane header. Each cell is a [key] coloured by state. */
.aim-areagrid {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin-bottom: 4dp;
}
.aim-grow {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
}
.aim-gcell {
    white-space: pre;
    padding: 0 1dp;
}
.aim-specials {
    margin-top: 2dp;
}
