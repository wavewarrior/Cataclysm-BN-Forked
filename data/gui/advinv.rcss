/* Advanced inventory (AIM) dual-pane (Tier 3 sub-project, slice 1). Palette/border/
   scrollbar/.scroll-pane/.panel from theme.rcss. Rows/cells are display:flex columns
   (RmlUi divs default to inline — theme.rcss gotcha) so amt/weight/vol align without
   absolute positions. */
body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.aim-root {
    width: 96%;
    height: 94%;
    display: flex;
    flex-direction: row;
}

/* Two equal panes; a divider between them. */
.aim-pane {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}
.aim-pane:first-child {
    margin-right: 6dp;
    padding-right: 6dp;
    border-right: 1dp #5a5a78ff;
}

/* Pane header: area name left, weight/volume capacity right. */
.aim-phead {
    flex: 0 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4dp;
    padding-bottom: 4dp;
    border-bottom: 1dp #5a5a78ff;
}
.aim-title {
    color: #ffffffff;
}
.aim-cap {
    color: #9a9ab0ff;
    white-space: pre;
    text-align: right;
}

.aim-list {
    flex: 1;
    min-height: 0;
}

/* Column-header row + item rows share the cell column geometry. */
.aim-colhead {
    display: flex;
    flex-direction: row;
    color: #9a9ab0ff;
    border-bottom: 1dp #5a5a78ff;
    margin-bottom: 2dp;
}
.aim-row {
    display: flex;
    flex-direction: row;
    padding: 0 2dp;
    border-radius: 3dp;
}
.aim-row:hover {
    background-color: #3a3a55ff;
}
.aim-row.selected {
    background-color: #ffcc66ff;
    color: #1e1e28ff;
}
.aim-cat {
    display: block;
    text-align: center;
    color: #d76fd7ff;
    margin-top: 2dp;
}

/* Cells: name fills, the three numeric columns are fixed-width + right-aligned. */
.aim-c-name {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
}
.aim-c-amt {
    flex: 0 0 auto;
    width: 42dp;
    text-align: right;
    white-space: pre;
}
.aim-c-wt {
    flex: 0 0 auto;
    width: 56dp;
    text-align: right;
    white-space: pre;
}
.aim-c-vol {
    flex: 0 0 auto;
    width: 50dp;
    text-align: right;
    white-space: pre;
}
