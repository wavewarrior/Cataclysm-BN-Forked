/* Layout for the NPC dialogue window (Tier 5). Header + two panes: history
   (left, 3/5) and responses (right). Reuses theme .panel / .item / .scroll-pane. */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.dlg-panel {
    width: 80%;
    min-width: 640dp;
    height: 84%;
    display: flex;
    flex-direction: column;
}

.dlg-header {
    display: block;
    flex: 0 0 auto;
    margin-bottom: 4dp;
    border-bottom: 1dp {{bg4}};
    padding-bottom: 4dp;
}

.dlg-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

.dlg-history {
    flex: 3;
    min-width: 0;
    white-space: pre-wrap;
    border-right: 1dp {{bg4}};
    padding-right: 8dp;
}

.dlg-resp-pane {
    flex: 2;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding-left: 8dp;
}

.dlg-resp-label {
    display: block;
    flex: 0 0 auto;
    color: {{fg}};
    margin-bottom: 4dp;
}

.dlg-resp-list {
    flex: 1;
    min-height: 0;
}

.dlg-resp {
    display: block;
    white-space: pre-wrap;
    margin-bottom: 2dp;
}

.dlg-keybinds {
    display: block;
    flex: 0 0 auto;
    white-space: pre-wrap;
    border-top: 1dp {{bg4}};
    padding-top: 4dp;
}
