/* Layout for the title screen (Tier 4 #3: main_menu). Vertical left rail
   with title block above, optional bordered submenu column, open right context
   area with bottom-anchored card, footer keybind hints.
   Palette lives in mainmenu_theme.rcss. */

body {
    width: 100%;
    height: 100%;
}

.mm-root {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 24dp 28dp;
}

/* Title block — above the columns, left-aligned */
.mm-title-block {
    flex: 0 0 auto;
    padding: 0 16dp;
}

.mm-title-main {
    font-size: 34dp;
    font-weight: bold;
    letter-spacing: 6dp;
}

.mm-title-sub {
    font-size: 16dp;
    letter-spacing: 3dp;
    margin-top: 2dp;
}

.mm-version {
    font-size: 12dp;
    margin-top: 4dp;
}

.mm-separator {
    flex: 0 0 auto;
    height: 1dp;
    margin: 12dp 0;
}

/* Main content row: rail + connector-col + subcol + context */
.mm-main {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

/* Connector column: flex item between rail and subcol.
   Natural flow placement — no absolute positioning. */
.mm-connector-col {
    flex: 0 0 auto;
    width: 16dp;
    display: flex;
    flex-direction: column;
}
.mm-conn-spacer {
    flex: 0 0 auto;
}
.mm-conn-ibeam {
    flex: 0 0 auto;
    height: 14dp;
    width: 100%;
}
.mm-conn-bar {
    margin-top: 6dp;
    height: 2dp;
    width: 100%;
}

/* Left rail — vertical nav only.
   position:relative so data-style-top bob offset moves the element
   AND its runic frame together (apply_crt reads GetAbsoluteOffset). */
.mm-rail {
    flex: 0 0 auto;
    width: 260dp;
    display: flex;
    flex-direction: column;
    padding: 12dp 16dp;
    position: relative;
}

.mm-nav {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
}

.mm-nav-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 8dp 10dp;
    margin: 1dp 0;
}

.mm-nav-icon {
    flex: 0 0 auto;
    width: 24dp;
    height: 24dp;
}

.mm-nav-label {
    font-size: 16dp;
    margin-left: 10dp;
}

/* Submenu column — runic-framed region (runic-region class, no close-X).
   border: 20dp transparent reserves the ring for apply_crt's procedural frame.
   position:relative for bob offset. */
.mm-subcol {
    flex: 0 0 auto;
    width: 300dp;
    align-self: flex-start;
    max-height: 60vh;
    display: flex;
    flex-direction: column;
    border: 20dp transparent;
    padding: 12dp;
    overflow-y: auto;
    position: relative;
}

.mm-section-header {
    flex: 0 0 auto;
    margin-bottom: 8dp;
}

.mm-action-list {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
}

.mm-action-row {
    display: block;
    padding: 4dp 10dp;
    margin: 1dp 0;
}

/* Right context area: open space, content bottom-anchored */
.mm-context-area {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    margin-left: 16dp;
}

/* MOTD/Credits panel: fills space, header above scrollable text */
.mm-motd-panel {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 16dp;
}

.mm-scroll-text {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
}

.mm-scroll-line {
    display: block;
    white-space: pre-wrap;
}

/* Context card: compact, bottom-anchored */
.mm-context-card {
    flex: 0 0 auto;
    max-height: 30%;
    padding: 12dp 16dp;
    overflow-y: auto;
}

.mm-context-body {
    white-space: pre-wrap;
}

/* Footer */
.mm-footer {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 10dp;
}

.mm-tips {
    white-space: pre-wrap;
    text-align: center;
}

.mm-keybinds {
    text-align: center;
    margin-top: 4dp;
}
