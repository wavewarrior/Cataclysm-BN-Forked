/* Layout for the title screen (Tier 4 #3: main_menu). Vertical left rail:
   title block + vertical nav, optional submenu column, open right context area
   with bottom-anchored card, footer keybind hints. Palette in mainmenu_theme.rcss. */

body {
    width: 100%;
    height: 100%;
}

.mm-root {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 24dp 28dp;
}

.mm-main {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

/* Left rail */
.mm-rail {
    flex: 0 0 auto;
    width: 280dp;
    display: flex;
    flex-direction: column;
    padding: 16dp;
}

.mm-title-block {
    flex: 0 0 auto;
}

.mm-title-main {
    font-size: 34dp;
    font-weight: bold;
    letter-spacing: 6dp;
}

.mm-title-sub {
    font-size: 16dp;
    letter-spacing: 3dp;
    margin-top: 2dp;
}

.mm-version {
    font-size: 12dp;
    margin-top: 4dp;
}

.mm-separator {
    flex: 0 0 auto;
    height: 1dp;
    margin: 12dp 0;
}

.mm-nav {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
}

.mm-nav-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 8dp 10dp;
    margin: 1dp 0;
}

.mm-nav-icon {
    flex: 0 0 auto;
    width: 24dp;
    height: 24dp;
}

.mm-nav-label {
    font-size: 16dp;
    margin-left: 10dp;
}

/* Submenu column */
.mm-subcol {
    flex: 0 0 auto;
    width: 240dp;
    display: flex;
    flex-direction: column;
    margin-left: 16dp;
    padding: 16dp;
}

.mm-section-header {
    flex: 0 0 auto;
    margin-bottom: 8dp;
}

.mm-action-list {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
}

.mm-action-row {
    display: block;
    padding: 4dp 10dp;
}

/* Right context area: open space, content bottom-anchored */
.mm-context-area {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    margin-left: 16dp;
}

.mm-scroll-text {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 16dp;
}

.mm-scroll-line {
    display: block;
    white-space: pre-wrap;
}

.mm-context-card {
    flex: 0 0 auto;
    max-height: 30%;
    padding: 12dp 16dp;
    overflow-y: auto;
}

.mm-context-body {
    white-space: pre-wrap;
}

/* Footer */
.mm-footer {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 10dp;
}

.mm-tips {
    white-space: pre-wrap;
    text-align: center;
}

.mm-keybinds {
    text-align: center;
    margin-top: 4dp;
}
