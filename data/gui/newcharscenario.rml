<rml>
<head>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="newchar_common.rcss"/>
    <link type="text/rcss" href="newcharscenario.rcss"/>
</head>
<body data-model="newcharscenario">
    <!-- Tier 4 screen #4 (new-character creator) slice 6: the SCENARIO tab
         (set_scenario). Char-tab strip (SCENARIO current) + top bar (points +
         the selected scenario's cost line) + a body split (scenario list left /
         a right info pane: sort indicator + professions / location / vehicle /
         flags) + a description footer + a filter indicator. Render-only doc;
         keyboard owns UP/DOWN, CONFIRM (pick), SORT, FILTER (string_input popup),
         RANDOMIZE, NEXT/PREV_TAB, QUIT. -->
    <div class="panel nc-panel">
        <div class="nc-steps">
            <div class="nc-step" data-for="t : tabs"
                 data-class-selected="t.selected" data-class-done="t.done">
                <div class="nc-step-icon" data-style-decorator="t.icon_dec"></div>
                <span class="nc-step-label" data-rml="t.name_rml"></span>
            </div>
        </div>
        <div class="nc-shell">
            <!-- Navigators. Shortcut text comes from the real binding via
                 input_context::get_desc, so it stays correct after a rebind. -->
            <div class="nc-arrow nc-arrow-prev" data-if="has_prev"
                 data-event-click="on_prev()">
                <div class="nc-arrow-glyph">&#60;</div>
                <div class="nc-arrow-key" data-rml="prev_key_rml"></div>
                <div class="nc-arrow-dest" data-rml="prev_name_rml"></div>
            </div>
            <div class="nc-arrow-spacer" data-if="!has_prev"></div>
            <div class="nc-stage">
            <div class="nc-scen-top">
                <span class="nc-scen-points" data-rml="points_rml"></span>
                <span class="nc-scen-cost" data-rml="cost_rml"></span>
                <!-- Screen-level control hint, so it belongs beside the other status text
                     rather than inside the per-scenario info panel. -->
                <span class="nc-scen-sort" data-rml="sort_rml"></span>
            </div>
            <div class="nc-scen-body">
                <!-- Grouped card tree. Each band is a header (a focus stop, so CONFIRM on
                     it toggles the group without needing a keybinding of its own) plus a
                     carousel row holding only the VISIBLE page of cards. -->
                <div class="nc-tree">
                    <div class="nc-band" data-for="b, bi : bands">
                        <div class="nc-band-head" data-class-focused="b.focused"
                             data-class-collapsed="b.collapsed"
                             data-event-click="on_band(bi)">
                            <span class="nc-band-marker" data-rml="b.marker_rml"></span>
                            <span class="nc-band-name" data-rml="b.name_rml"></span>
                            <span class="nc-band-count" data-rml="b.count_rml"></span>
                        </div>
                        <div class="nc-band-rail" data-if="!b.collapsed">
                            <div class="nc-band-pager" data-class-on="b.has_prev_page"
                                 data-event-click="on_page(bi, -1)">&#60;</div>
                            <div class="nc-band-cards">
                                <div class="nc-card" data-for="r : b.rows"
                                     data-class-selected="r.selected"
                                     data-class-chosen="r.chosen"
                                     data-class-unavailable="r.unavailable"
                                     data-event-click="on_card(bi, it_index)">
                                    <!-- Name owns the card's full width and wraps; the cost
                                         sits in the footer beside the flag strip. Sharing a
                                         row with the cost clipped every long single-word
                                         name ("Wilderness", "Ambush") instead of wrapping. -->
                                    <span class="nc-card-name" data-rml="r.text_rml"></span>
                                    <div class="nc-card-foot">
                                        <div class="nc-card-flags">
                                            <div class="nc-card-flag" data-for="i : r.icons"
                                                 data-style-decorator="i.dec"></div>
                                        </div>
                                        <span class="nc-card-pts" data-rml="r.cost_rml"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="nc-band-pager" data-class-on="b.has_next_page"
                                 data-event-click="on_page(bi, 1)">&#62;</div>
                        </div>
                        <!-- Floaty info panel for the scenario under the cursor, inside the
                             band so it reads as part of THIS category. Fixed height and
                             fixed position: changing scenario moves only the notch above
                             it, never the panel. Replaces the old right-hand pane, which
                             cost half the stage width to say the same thing. -->
                        <div class="nc-band-info" data-if="b.has_info">
                            <div class="nc-info-notches">
                                <!-- Gutters and one cell per card mirror the rail's flex
                                     geometry exactly, so the notch lands under its card
                                     without any pixel arithmetic. -->
                                <div class="nc-info-gutter"></div>
                                <div class="nc-info-cells">
                                    <div class="nc-info-cell" data-for="r : b.rows"
                                         data-class-on="r.selected">
                                        <div class="nc-info-notch"></div>
                                    </div>
                                </div>
                                <div class="nc-info-gutter"></div>
                            </div>
                            <div class="nc-info-panel">
                                <!-- Art slot. Bespoke per-scenario art does not exist yet, so
                                     this shows the START LOCATION's overmap art: the closest
                                     honest stand-in for "where this run begins". -->
                                <div class="nc-info-art" data-style-decorator="art_dec"></div>
                                <div class="nc-info-facts">
                                    <div class="nc-fact">
                                        <div class="nc-fact-label">Location</div>
                                        <div class="nc-fact-value" data-rml="loc_rml"></div>
                                        <div class="nc-fact-sub" data-rml="loc_sub_rml"></div>
                                    </div>
                                    <div class="nc-fact">
                                        <div class="nc-fact-label">Profession</div>
                                        <div class="nc-fact-value" data-rml="prof_rml"></div>
                                        <div class="nc-fact-sub" data-rml="prof_sub_rml"></div>
                                    </div>
                                    <div class="nc-fact">
                                        <div class="nc-fact-label">Vehicle</div>
                                        <div class="nc-fact-value" data-rml="veh_rml"></div>
                                    </div>
                                    <!-- This scenario's own sigils, restated in words. -->
                                    <div class="nc-chips">
                                        <div class="nc-chip" data-for="c : chips">
                                            <div class="nc-chip-icon" data-style-decorator="c.dec"></div>
                                            <span class="nc-chip-label" data-rml="c.label_rml"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="nc-info-desc" data-rml="desc_rml"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Key for the card strips: "sigil :: meaning", spread across the panel.
                 Without it the glyphs are decoration; the info panel names the flags of
                 only the ONE selected scenario. -->
            <div class="nc-legend">
                <div class="nc-legend-item" data-for="l : legend">
                    <div class="nc-legend-icon" data-style-decorator="l.dec"></div>
                    <span class="nc-legend-sep">::</span>
                    <span class="nc-legend-label" data-rml="l.label_rml"></span>
                </div>
            </div>
            <div class="nc-scen-filter" data-rml="filter_rml"></div>
            </div>
            <div class="nc-arrow nc-arrow-next" data-if="has_next"
                 data-event-click="on_next()">
                <div class="nc-arrow-glyph">&#62;</div>
                <div class="nc-arrow-key" data-rml="next_key_rml"></div>
                <div class="nc-arrow-dest" data-rml="next_name_rml"></div>
            </div>
            <div class="nc-arrow-spacer" data-if="!has_next"></div>
        </div>
        <div class="nc-exit" data-rml="exit_rml"></div>
    </div>
    <div id="crt-overlay" class="crt"></div>
</body>
</rml>
