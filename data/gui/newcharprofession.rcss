/* Layout for the new-character PROFESSION tab (Tier 4 #4 slice 7). Reuses theme
   .panel / .tabs / .tab / .item / .scroll-pane. */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

/* 72%, not 80/92%: the character-preview box is pinned to the right of the screen
   and its avatar is a GPU sprite drawn UNDERNEATH this document, so an opaque panel
   reaching over that box hides the sprite. A centred panel of width W has its right
   edge at (100+W)/2, so 72% ends at 86% and the box starts at ~86.7% — they never
   meet. 80% (right edge 90%) cleared the old box by 0.2% by luck; 92% covered it.
   Keep all eight tabs identical so the panel edge does not jump while tabbing.
   See nc_prepare_preview() in newcharacter_ui.cpp. */
.nc-panel {
    width: 72%;
    min-width: 720dp;
    height: 92%;
    display: flex;
    flex-direction: column;
}

.nc-tabs {
    flex: 0 0 auto;
}

.nc-tabs .tab {
    flex: 0 0 auto;
}

.nc-prof-top {
    flex: 0 0 auto;
    display: flex;
    flex-direction: row;
    padding: 6dp 8dp;
}

.nc-prof-points {
    display: block;
    flex: 0 0 auto;
    margin-right: 16dp;
}

.nc-prof-cost {
    display: block;
    flex: 1;
}

.nc-prof-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

.nc-prof-list {
    flex: 1;
    min-width: 0;
    border-right: 1dp {{bg4}};
    padding-right: 8dp;
}

.nc-prof-row {
    display: block;
}

.nc-prof-right {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding-left: 8dp;
}

.nc-prof-sort {
    display: block;
    flex: 0 0 auto;
}

.nc-prof-gender {
    display: block;
    flex: 0 0 auto;
    margin-bottom: 6dp;
}

.nc-prof-info {
    flex: 1;
    min-height: 0;
    white-space: pre-wrap;
}

.nc-prof-desc {
    flex: 0 0 auto;
    max-height: 80dp;
    overflow-y: auto;
    white-space: pre-wrap;
    padding: 6dp 8dp;
    border-top: 1dp {{bg4}};
    color: {{fg}};
}

.nc-prof-filter {
    display: block;
    flex: 0 0 auto;
    padding: 2dp 8dp;
    color: {{gray}};
}
