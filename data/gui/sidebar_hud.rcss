/* Tier 7 sidebar HUD layout. The body is transparent (the cleared sidebar region
   shows through); the HUD column is absolutely positioned and stacks migrated panels
   top-down to mirror game::draw_panels. The column's left/top/width are set from C++
   (sidebar_hud_position) as PERCENTAGES of the window — the curses terminal is
   TERMX×TERMY cells spanning the full window, so a panel that is W cells wide at the
   right edge is (W/TERMX*100)% wide anchored at ((TERMX-W)/TERMX*100)% from the left.
   This auto-tracks window resize and honours SIDEBAR_POSITION (left/right). */

body {
    background-color: transparent;
    width: 100%;
    height: 100%;
}

.hud-col {
    position: absolute;
    /* left / top / width injected from C++; defaults keep it on-screen pre-position. */
    left: 0;
    top: 0;
    width: 25%;
    display: flex;
    flex-direction: column;
}

/* display:block — RmlUi elements default to inline; a sidebar row must be a block or
   it flows horizontally (documented gotcha in theme.rcss, bit mutations/diary). */
.hud-panel {
    display: block;
    white-space: pre-wrap;
}
