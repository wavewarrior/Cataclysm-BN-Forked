/* Tier 7 sidebar HUD layout — STRUCTURAL PIVOT (slice 3, 2026-06-20).

   ONE absolutely-positioned container (#hud-sidebar) = the sidebar rect. C++
   (sidebar_hud_apply_rect) injects left/top/width/height as PERCENTAGES of the window
   each frame: the curses terminal is TERMX*TERMY cells over the full window, so a
   sidebar W cells wide at the right edge is (W/TERMX*100)% wide anchored at
   ((TERMX-W)/TERMX*100)% from the left, full height. Auto-tracks resize + honours
   SIDEBAR_POSITION (left/right).

   Inside it, rows flow as a flex COLUMN (document flow — this is what kills the
   per-panel height/overlap class the absolute machinery suffered). Fixed-height rows
   size to content; flex sentinel rows (.flex = log/minimap, height -2/-1) grow to fill
   the remainder. The body is transparent so the cleared (black) sidebar shows through. */

body {
    background-color: transparent;
    width: 100%;
    height: 100%;
}

.hud-sidebar {
    position: absolute;
    /* left / top / width / height injected from C++ each frame. */
    display: flex;
    flex-direction: column;
    background-color: {{hud-bg}};
    border-left: 1dp {{hud-border}};
    padding: 6dp 8dp;
}

/* display:block — RmlUi elements default to inline; a row must be block or it flows
   horizontally (documented gotcha in theme.rcss, bit mutations/diary).
   white-space:pre-wrap preserves the producers' spacing + newlines. */
.hud-row {
    display: block;
    white-space: pre-wrap;
    flex: 0 0 auto;
    margin-bottom: 6dp;
}

/* Sentinel-height panels (log -2 / minimap -1) absorb the leftover column height;
   the inner body (not the row) needs to grow so the header stays pinned above it. */
.hud-row.flex {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
}
.hud-row.flex .hud-row-body {
    flex: 1 1 auto;
}

/* Qud inset all-caps panel header; empty titles skip this div entirely (data-if). */
.hud-row-header {
    color: {{hud-fg-bright}};
    background-color: {{hud-bg-panel}};
    border-bottom: 1dp {{hud-border}};
    font-size: 0.95em;
    font-weight: bold;
    letter-spacing: 2dp;
    padding: 3dp 6dp;
    margin-bottom: 3dp;
}
.hud-row-body {
    color: {{hud-fg}};
    padding: 2dp 4dp;
    line-height: 1.3;
}

/* Qud fill bar: producer emits <div class="qbar"><div class="qbar-fill"
   style="width:N%; background-color:#rgb"/></div> */
.qbar {
    display: inline-block;
    width: 60dp;
    height: 8dp;
    background-color: {{hud-bar-bg}};
    border: 1dp {{hud-border}};
    vertical-align: middle;
}
.qbar-fill {
    height: 100%;
}

/* Limbs panel: one Qud bar row per body part (producer emits <div class="hud-limb-row">
   <span class="hud-limb-name">…</span><div class="qbar">…</div> …</div>) */
.hud-limb-row {
    display: block;
    padding: 1dp 0dp;
}
.hud-limb-name {
    display: inline-block;
    width: 5em;
}

/* Threat compass grid */
.tc-row {
    display: block;
    white-space: pre;
    padding: 1dp 0dp;
}
.tc-cell {
    display: inline-block;
    width: 3em;
    text-align: center;
}
.tc-cell.danger {
    background-color: {{hud-sel}};
}

/* Map chunk + inline SVG icons */
.hud-map {
    white-space: pre;
    text-align: center;
}
.hud-icon {
    vertical-align: middle;
}

/* Qud top/bottom screen chrome strips (Phase 2) — absolute, full viewport width minus
   the sidebar; rect + height injected from C++ (sidebar_hud_apply_rect) each sync. */
#hud-topbar,
#hud-botbar {
    position: absolute;
    background-color: {{hud-bg}};
    overflow: hidden;
    padding: 2dp 8dp;
}
#hud-topbar {
    border-bottom: 1dp {{hud-border}};
}
#hud-botbar {
    border-top: 1dp {{hud-border}};
}
.hud-strip-row {
    display: block;
    white-space: pre;
    color: {{hud-fg}};
    padding: 2dp 6dp;
}
/* Two-span layout for a strip row: left-aligned info, right-aligned readout
   (producers emit `<span class="strip-left">…</span><span class="strip-right">…</span>`). */
.strip-left {
    display: inline;
}
.strip-right {
    float: right;
}
