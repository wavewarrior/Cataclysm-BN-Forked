/* Full Qud-inspired HUD layout — fixed regions, absolute positioning.
   Regions: #hud-topbar (1 row, full width), #hud-vitals (overlay, top-left),
   #hud-dock (minimap+log, right edge), #hud-botbar (effects/target, bottom),
   #hud-hotbar (keybinds, bottom-1).

   All regions are positioned absolutely by C++ (sidebar_hud_apply_rect) each
   sync. The sidebar width is carved from the viewport edge. */

body {
    background-color: transparent;
    width: 100%;
    height: 100%;
    font-family: "Source Code Pro";
    font-size: 15dp;
    color: {{hud-fg}};
}

/* Base strip row styles */
.hud-strip-row {
    display: block;
    white-space: pre;
    color: {{hud-fg}};
    padding: 1dp 8dp;
}

/* Icon inline with text */
.hud-icon {
    width: 13dp;
    height: 13dp;
    vertical-align: middle;
}

/* ========== TOP BAR ========== */
#hud-topbar {
    position: absolute;
    background-color: {{hud-bg}};
    overflow: hidden;
    border-bottom: 1dp {{hud-border}};
    padding: 1dp 8dp;
}

/* ========== BOTTOM BAR ========== */
#hud-botbar {
    position: absolute;
    background-color: {{hud-bg}};
    overflow: hidden;
    border-top: 1dp {{hud-border}};
    padding: 1dp 8dp;
}

/* ========== HOTBAR ========== */
#hud-hotbar {
    position: absolute;
    background-color: {{hud-bg}};
    overflow: hidden;
    padding: 1dp 8dp;
}

/* ========== VITALS OVERLAY ========== */
#hud-vitals {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2dp;
}

.hud-vitals-inner {
    display: flex;
    flex-direction: column;
    gap: 2dp;
}

/* Chunky Qud HP bars */
.vbar {
    position: relative;
    height: 15dp;
    width: 230dp;
    background-color: {{hud-bar-bg}};
    margin-bottom: 2dp;
}
.vbar-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    background-color: {{hud-fg-bright}};
}
.vbar-text {
    position: absolute;
    top: 0;
    width: 100%;
    height: 100%;
    color: #0d0d0dff;
    font-size: 0.85em;
}
.vbar-tick {
    position: absolute;
    top: 0;
    width: 1dp;
    height: 100%;
    background-color: #0d0d0dff;
}
/* Thin bars (STA, MANA) */
.vbar.thin {
    height: 9dp;
    width: 230dp;
}
.vbar.thin .vbar-fill {
    height: 100%;
}
.vbar.thin .vbar-text {
    font-size: 0.75em;
}
.vbar.crit {
    background-color: #401010ff;
}
.vbar.crit .vbar-fill {
    background-color: #e05050ff;
}
.vbar.crit .vbar-text {
    color: #e05050ff;
}

/* ========== DOCK ========== */
#hud-dock {
    position: absolute;
    display: flex;
    flex-direction: column;
    background-color: {{hud-bg}};
    border-left: 1dp {{hud-border}};
    padding: 6dp 12dp;
}

.dock-flex {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    margin-bottom: 0dp;
}

.dock-section {
    display: block;
    margin-bottom: 6dp;
}

.dock-header {
    color: {{hud-accent}};
    letter-spacing: 2dp;
    font-size: 0.85em;
    font-weight: bold;
    border-bottom: 1dp {{hud-border}};
    padding: 0dp 2dp 2dp 2dp;
    margin-bottom: 3dp;
}

/* ========== LOG ENTRIES ========== */
.hud-log-entry {
    display: block;
    white-space: pre-wrap;
    word-break: break-word;
    padding: 1dp 4dp;
    font-size: 0.9em;
}
.hud-log-symbol {
    display: inline;
    font-weight: bold;
    margin-right: 2dp;
}
.hud-log-time {
    display: inline;
    color: #888888ff;
    margin-right: 4dp;
    font-size: 0.85em;
}
.hud-log-text {
    display: inline;
}

.dock-body {
    color: {{hud-fg}};
    white-space: pre-wrap;
    line-height: 1.3;
}

.hud-map-body {
    white-space: pre;
    text-align: center;
}

/* Scrollable log area */
.hud-scroll {
    overflow-y: auto;
    min-height: 0;
}

/* ========== STRIP CHROME ========== */
.strip-left {
    display: inline;
}
.strip-right {
    float: right;
}

/* Target bar inline in botbar */
.tbar {
    display: inline-block;
    width: 40dp;
    height: 9dp;
    background-color: {{hud-bar-bg}};
    vertical-align: middle;
}
.tbar-fill {
    height: 100%;
}
/* ========== DAMAGE VIGNETTE ========== */
#hud-vignette {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 20;
    opacity: 0;
    decorator: radial-gradient( farthest-corner, #00000000, #e0505099 );
}
/* ========== ENVIRONMENTAL TINTING ========== */
.env-night   { opacity: 0.85; }
.env-fire    { background-color: rgba(255, 100, 30, 0.04); }
.env-rad     { background-color: rgba(30, 255, 60, 0.04); }
.env-cold    { background-color: rgba(100, 150, 255, 0.04); }
.env-storm   { opacity: 0.9; }

/* Smooth transitions for tint changes */
#hud-topbar, #hud-botbar, #hud-dock, #hud-vitals {
    transition: background-color 0.8s, opacity 0.8s;
}

/* Status effect animation targets (Phase 7) */
#status-poison, #status-fire, #status-bleed, #status-rad {
    display: inline;
}