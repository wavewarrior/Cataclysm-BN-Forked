/* Layout for the new-character SCENARIO tab (Tier 4 #4 slice 6). Reuses theme
   .panel / .tabs / .tab / .item / .scroll-pane. */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

/* 98%: creation fills the screen, with the remaining 1% each side keeping the panel's
   own border visible as a frame instead of running off the display edge. These four
   tabs have no character preview, so nothing sits outside the panel to be occluded.
   The four preview tabs stay narrow until the avatar composites through RmlUi — see
   plans/charcreation-wizard-flow.md. */
.nc-panel {
    width: 98%;
    height: 98%;
    display: flex;
    flex-direction: column;
}

.nc-steps {
    flex: 0 0 auto;
}

.nc-step {
    flex: 0 0 auto;
}

.nc-scen-top {
    flex: 0 0 auto;
    display: flex;
    flex-direction: row;
    padding: 6dp 8dp;
}

.nc-scen-points {
    display: block;
    flex: 0 0 auto;
    margin-right: 16dp;
}

.nc-scen-cost {
    display: block;
    flex: 1;
}

.nc-scen-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

.nc-scen-list {
    flex: 1;
    min-width: 0;
    border-right: 1dp {{bg4}};
    padding-right: 8dp;
}

.nc-scen-row {
    display: block;
}

.nc-scen-info {
    flex: 1;
    min-width: 0;
    padding-left: 8dp;
}

.nc-scen-sort {
    display: block;
    margin-bottom: 8dp;
}

.nc-scen-detail {
    display: block;
    white-space: pre-wrap;
}

.nc-scen-desc {
    flex: 0 0 auto;
    max-height: 80dp;
    overflow-y: auto;
    white-space: pre-wrap;
    padding: 6dp 8dp;
    border-top: 1dp {{bg4}};
    color: {{fg}};
}

.nc-scen-filter {
    display: block;
    flex: 0 0 auto;
    padding: 2dp 8dp;
    color: {{gray}};
}
