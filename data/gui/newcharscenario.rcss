/* Layout for the new-character SCENARIO tab (Tier 4 #4 slice 6). Reuses theme
   .panel / .tabs / .tab / .item / .scroll-pane. */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

/* 98%: creation fills the screen, with the remaining 1% each side keeping the panel's
   own border visible as a frame instead of running off the display edge. These four
   tabs have no character preview, so nothing sits outside the panel to be occluded.
   The four preview tabs stay narrow until the avatar composites through RmlUi — see
   plans/charcreation-wizard-flow.md. */
.nc-panel {
    width: 98%;
    height: 98%;
    display: flex;
    flex-direction: column;
}

.nc-steps {
    flex: 0 0 auto;
}

.nc-step {
    flex: 0 0 auto;
}

.nc-scen-top {
    flex: 0 0 auto;
    display: flex;
    flex-direction: row;
    padding: 6dp 8dp;
}

.nc-scen-points {
    display: block;
    flex: 0 0 auto;
    margin-right: 16dp;
}

.nc-scen-cost {
    display: block;
    flex: 1;
}

.nc-scen-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

.nc-scen-sort {
    display: block;
    flex: 0 0 auto;
    /* Guaranteed gap: the cost line beside it is `flex: 1`, so a long scenario name
       ("Challenge - Really Bad Day earns 0 points") grows until it butts straight into this
       hint and the two read as one welded string. */
    margin-left: 20dp;
    color: {{gray}};
}


.nc-scen-filter {
    display: block;
    flex: 0 0 auto;
    padding: 2dp 8dp;
    color: {{gray}};
}

/* ── MOTION ────────────────────────────────────────────────────────────────────
   Transitions live INSIDE each element's own rule above, not in a block down here: a second
   rule for the same selector is how a property quietly ends up split across two places and
   one of them loses. See the individual rules for `transition` declarations.

   State changes only — no entry animations. `data-for` regenerates these elements whenever
   the array is dirtied (every redraw on this screen), so an entry keyframe would restart
   continuously and read as a flicker. A transition is safe because it animates a VALUE
   change on an element that survives.

   Durations are deliberately short: this is a chooser the player scrubs through with the
   arrow keys, and anything slower than ~0.15s turns a cursor move into a wait. */
