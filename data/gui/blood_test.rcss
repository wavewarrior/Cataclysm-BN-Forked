/* Layout for the Blood Test Results popup (Character::conduct_blood_analysis).
   Palette/border/.panel come from theme.rcss (linked first). A small centered,
   dismiss-only box: red title over one coloured line per effect. Monospace +
   pre-wrap preserve the folded layout. Lengths in dp. */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.bt-panel {
    width: 46ch;
    max-width: 80%;
    max-height: 80%;
    display: flex;
    flex-direction: column;
    border-color: {{red}};
}

.bt-title {
    flex: 0 0 auto;
    text-align: center;
    padding-bottom: 4dp;
    margin-bottom: 4dp;
    border-bottom: 1dp {{bg4}};
}

.bt-body {
    flex: 1;
    min-height: 0;
    white-space: pre-wrap;
}
