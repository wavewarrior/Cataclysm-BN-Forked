/* Defense game-mode CARAVAN shop (§8.1 backlog, slice 2). Palette/border from
   theme.rcss (linked first). Two columns: left = cash header + category list +
   selected-item info; right = the item list. The focused pane takes an accent
   border (cat_active / items_active), mirroring the curses yellow border. */
body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.cv-panel {
    width: 90%;
    height: 90%;
    display: flex;
    flex-direction: row;
}

.cv-left {
    flex: 0 0 45%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    margin-right: 4dp;
}

.cv-cash {
    flex: 0 0 auto;
    margin-bottom: 4dp;
    white-space: nowrap;
}

.cv-cats {
    flex: 0 0 auto;
    max-height: 40%;
    overflow-y: auto;
    padding: 2dp;
    border: 1dp {{bg4}};
}

.cv-info {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    white-space: pre-wrap;
    padding: 2dp;
    margin-top: 4dp;
    border: 1dp {{bg4}};
}

.cv-items {
    flex: 1;
    min-width: 0;
    overflow-y: auto;
    padding: 2dp;
    border: 1dp {{bg4}};
}

/* Focused pane → accent border (curses drew it yellow). */
.cv-cats.active, .cv-items.active {
    border-color: {{accent}};
}

.cv-row {
    display: flex;
    justify-content: space-between;
    white-space: nowrap;
}

.cv-row.selected {
    background-color: {{accent}};
    color: {{bg0}};
}

.cv-item-price {
    margin-left: 12dp;
}
