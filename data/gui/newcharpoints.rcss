/* Layout for the new-character POINTS tab (Tier 4 #4 slice 1). Reuses theme
   .panel / .tabs / .tab / .item / .scroll-pane. body must be sized + centered
   (the missions gotcha — otherwise the panel shrink-wraps / collapses), and
   .nc-opt needs display:block (RmlUi elements default to display:inline; the
   mutations/diary gotcha — rows would flow horizontally otherwise). */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

/* 98%: creation fills the screen, with the remaining 1% each side keeping the panel's
   own border visible as a frame instead of running off the display edge. These four
   tabs have no character preview, so nothing sits outside the panel to be occluded.
   The four preview tabs stay narrow until the avatar composites through RmlUi — see
   plans/charcreation-wizard-flow.md. */
.nc-panel {
    width: 98%;
    height: 98%;
    display: flex;
    flex-direction: column;
}

.nc-steps {
    flex: 0 0 auto;
}

/* Character-creation steps size to content (theme .tab is flex:1, which would
   truncate the 8 captions). */
.nc-step {
    flex: 0 0 auto;
}

/* Centred composition for the pool choice, mirroring UI_designs/10_charcreation_*:
   title block, then the budget line, then the cards. */
.nc-stage-centred {
    align-items: center;
    justify-content: center;
}

.nc-title-block {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 4dp;
}

.nc-title {
    display: block;
    color: {{yellow}};
    font-size: 22dp;
    letter-spacing: 4dp;
    font-effect: glow( 2dp {{yellow-glow}} );
}

.nc-subtitle {
    display: block;
    color: {{fg4}};
    letter-spacing: 2dp;
}

.nc-points {
    display: block;
    flex: 0 0 auto;
    padding: 8dp;
    color: {{fg}};
}

/* Row of pool cards. `justify-content: center` with fixed-width cards, NOT flex:1 —
   CHARACTER_POINT_POOLS can leave only one pool available, and a stretched single card
   would fill the screen and stop reading as a choice at all. */
.nc-cards {
    flex: 0 0 auto;
    display: flex;
    flex-direction: row;
    justify-content: center;
    margin-top: 12dp;
}

.nc-card {
    flex: 0 0 auto;
    width: 300dp;
    /* Explicit height, not shrink-to-fit. `.nc-card-info { flex: 1 }` resolves against
       the parent's height, so with an auto-height card the info slot collapsed to a
       sliver — the name was clipped by the bottom border and the body text never drew
       at all. A fixed height also keeps all cards level when their copy differs in
       length (Multiple pools runs three lines, Freeform one). */
    height: 380dp;
    display: flex;
    flex-direction: column;
    margin: 0 12dp;
    padding: 14dp;
    background-color: {{bg-hard}};
    /* Reserved on every card so the selected border does not resize the row. */
    border: 1dp {{bg4}};
}

.nc-card:hover {
    border-color: {{fg4}};
}

/* Cursor. Distinct from `chosen` on purpose: you can be looking at a card you have
   not picked, and the two states must be tellable apart at a glance. */
.nc-card.selected {
    border-color: {{yellow}};
}

/* The pool actually in force — a filled left edge, so it survives losing the cursor. */
.nc-card.chosen {
    border-left-width: 4dp;
    border-left-color: {{yellow}};
}

/* Upper slot: placeholder rune now, real art later. Fixed square so every card is the
   same height whatever its text length. */
.nc-card-art {
    flex: 0 0 auto;
    width: 100%;
    height: 110dp;
    margin-bottom: 10dp;
}

/* Lower slot, built for the option's own copy. */
.nc-card-info {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    border-top: 1dp {{bg4}};
    padding-top: 8dp;
}

.nc-card-name {
    display: block;
    flex: 0 0 auto;
    font-weight: bold;
    letter-spacing: 1dp;
    margin-bottom: 4dp;
}

.nc-card-text {
    display: block;
    flex: 1;
    min-height: 0;
    white-space: pre-wrap;
    overflow-y: auto;
}
