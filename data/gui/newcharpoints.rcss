/* Layout for the new-character POINTS tab (Tier 4 #4 slice 1). Reuses theme
   .panel / .tabs / .tab / .item / .scroll-pane. body must be sized + centered
   (the missions gotcha — otherwise the panel shrink-wraps / collapses), and
   .nc-opt needs display:block (RmlUi elements default to display:inline; the
   mutations/diary gotcha — rows would flow horizontally otherwise). */

body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

/* 72%, not 80/92%: the character-preview box is pinned to the right of the screen
   and its avatar is a GPU sprite drawn UNDERNEATH this document, so an opaque panel
   reaching over that box hides the sprite. A centred panel of width W has its right
   edge at (100+W)/2, so 72% ends at 86% and the box starts at ~86.7% — they never
   meet. 80% (right edge 90%) cleared the old box by 0.2% by luck; 92% covered it.
   Keep all eight tabs identical so the panel edge does not jump while tabbing.
   See nc_prepare_preview() in newcharacter_ui.cpp. */
.nc-panel {
    width: 72%;
    min-width: 720dp;
    height: 92%;
    display: flex;
    flex-direction: column;
}

.nc-tabs {
    flex: 0 0 auto;
}

/* Character-creation steps size to content (theme .tab is flex:1, which would
   truncate the 8 captions). */
.nc-tabs .tab {
    flex: 0 0 auto;
}

.nc-points {
    display: block;
    flex: 0 0 auto;
    padding: 8dp;
    color: {{fg}};
}

.nc-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
}

.nc-opts {
    flex: 0 0 auto;
    min-width: 280dp;
    border-right: 1dp {{bg4}};
    padding-right: 8dp;
}

.nc-opt {
    display: block;
}

.nc-desc {
    flex: 1;
    min-width: 0;
    white-space: pre-wrap;
    padding: 8dp;
    color: {{fg}};
}
