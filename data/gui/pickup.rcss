/* Layout for the item pickup menu (§8.1 backlog: pickup.cpp pick_up_from_items).
   Palette/border/scrollbar/.scroll-pane come from theme.rcss (linked first in
   pickup.rml); this file owns only the screen's own layout. Lengths in dp.

   A header (weight/volume prediction), a scrolling multi-select list, a
   selected-item info title + scrolling info pane, and a footer hint line. Rows
   are flex (hotkey | mark | name); list/info are .scroll-pane block containers
   (RmlUi divs default to inline — see the theme.rcss gotcha). Per-segment colour
   is baked into the bound spans via cata_text_to_rml, so this file only positions.
   The selected row gets the shared accent highlight. */
body {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.pu-panel {
    width: 70%;
    max-width: 760dp;
    height: 90%;
    display: flex;
    flex-direction: column;
}

.pu-header {
    flex: 0 0 auto;
    color: {{fg}};
    border-bottom: 1dp {{bg4}};
    padding-bottom: 2dp;
    margin-bottom: 2dp;
    white-space: nowrap;
}

/* The scrolling multi-select list. Takes the larger share of the panel. */
.pu-list {
    flex: 2 1 0;
    min-height: 0;
}

.pu-row {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    white-space: nowrap;
}

.pu-row.selected {
    background-color: {{yellow}};
    color: {{bg-hard}};
}

.pu-key {
    display: block;
    flex: 0 0 28dp;
}

.pu-mark {
    display: block;
    flex: 0 0 28dp;
}

.pu-name {
    display: block;
    flex: 1;
    min-width: 0;
    text-overflow: ellipsis;
}

/* Selected-item info title (< item name >) + scrolling info pane below. */
.pu-info-title {
    flex: 0 0 auto;
    border-top: 1dp {{bg4}};
    padding-top: 2dp;
    margin-top: 2dp;
    white-space: nowrap;
}

.pu-info {
    flex: 1 1 0;
    min-height: 0;
    white-space: pre-wrap;
}

.pu-footer {
    flex: 0 0 auto;
    border-top: 1dp {{bg4}};
    padding-top: 2dp;
    margin-top: 2dp;
    color: {{fg4}};
    white-space: nowrap;
}
