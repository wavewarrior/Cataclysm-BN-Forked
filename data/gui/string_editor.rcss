body {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
}

#se-panel {
  display: flex;
  flex-direction: column;
  width: 80%;
  min-width: 600dp;
  height: 80%;
  min-height: 400dp;
  border: 1px #666;
  background: #111;
}

#se-content {
  flex: 1;
  overflow-y: auto;
  padding: 4dp 8dp;
}

#se-hints {
  padding: 4dp 8dp;
  border-top: 1px #444;
  color: #aaa;
  font-size: 12dp;
}

.se-row {
  display: block;
  white-space: pre;
}

.se-ln {
  color: #666;
}

.se-cursor {
  display: inline-block;
  min-width: 9dp;
  height: 1.1em;
  background-color: {{fg0}};
  color: {{bg}};
}

.se-ime {
  text-decoration: underline;
  color: #aaa;
}
