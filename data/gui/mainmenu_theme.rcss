/* Dark Runic Gold palette for the title screen.
   Deep charcoal background, warm gold accents, cyan interactive highlights.
   Scoped to .mm-* classes to avoid leaking into the shared theme. */

/* Translucent surfaces — particles read through. */
.mm-rail, .mm-subcol, .mm-scroll-text, .mm-context-card {
    background-color: rgba(10, 10, 15, 0.60);
}

/* Title treatment. */
.mm-title-main {
    color: #c4a832;
    font-effect: glow(3dp rgba(196, 168, 50, 0.6));
}
.mm-title-sub {
    color: #a1885f;
}

/* Navigation items — base state. */
.mm-nav-item {
    color: #a1885f;
    background-color: transparent;
}
.mm-nav-item:hover {
    color: #c4a832;
    background-color: rgba(196, 168, 50, 0.1);
}
/* Unfocused-column selection: dimmer. */
.mm-nav-item.selected {
    color: #c4a832;
    background-color: rgba(196, 168, 50, 0.12);
}
/* Focused-column selection: bright highlight. */
.mm-rail.focused .mm-nav-item.selected {
    color: #c4a832;
    background-color: rgba(196, 168, 50, 0.25);
    font-effect: glow(2dp rgba(196, 168, 50, 0.4));
}

/* Nav icon glyphs. */
.mm-nav-icon {
    color: #5ab0a0;
}
.mm-nav-item.selected .mm-nav-icon {
    color: #70d0c0;
}

/* Action rows (submenu items) — base state. */
.mm-action-row {
    color: #c4b89a;
}
.mm-action-row:hover {
    color: #d4c8a0;
    background-color: rgba(196, 168, 50, 0.08);
}
/* Unfocused-column selection. */
.mm-action-row.selected {
    color: #c4a832;
    background-color: rgba(196, 168, 50, 0.10);
}
/* Focused-column selection. */
.mm-subcol.focused .mm-action-row.selected {
    color: #c4a832;
    background-color: rgba(196, 168, 50, 0.25);
}

/* Section headers. */
.mm-section-header {
    color: #a1885f;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 3dp;
}

/* Separator lines. */
.mm-separator {
    border-top: 1dp dotted #3a3a4a;
}

/* Tips / footer. */
.mm-tips {
    color: #7a7060;
}
.mm-keybinds {
    color: #5a5a6a;
}

/* Version text. */
.mm-version {
    color: #6a6a7a;
}

/* Scroll text (MOTD/Credits). */
.mm-scroll-line {
    color: #a09880;
}

/* Context body (right panel non-scroll content). */
.mm-context-body {
    color: #a09880;
}
