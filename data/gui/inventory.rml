<rml>
<head>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="inventory.rcss"/>
</head>
<body data-model="inventory">
    <!-- Tier 3 framework migration, SLICE 1 (inventory_pick_selector only, gated
         per selector subclass via inventory_selector::uses_rml()). Title + hint
         header / a single scrolling list of rows (visible columns flattened — true
         multi-column side-by-side is a later slice) / footer. Each row is finished
         markup (invlet + cell text); category rows render as a header; the active
         column's selected row gets the cursor highlight. Keyboard owns all input
         (the existing execute() loop); mouse-select is deferred to a later slice. -->
    <div class="panel inv-panel">
        <div class="inv-title" data-rml="title_rml"></div>
        <div class="inv-hint" data-rml="hint_rml"></div>
        <div class="inv-list scroll-pane">
            <div class="inv-row" data-for="row : rows"
                 data-class-category="row.is_category"
                 data-class-selected="row.selected"
                 data-rml="row.text_rml"></div>
        </div>
        <div class="inv-footer" data-rml="footer_rml"></div>
    </div>
</body>
</rml>
