<rml>
<head>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="newchar_common.rcss"/>
    <link type="text/rcss" href="newchartraits.rcss"/>
</head>
<body data-model="newchartraits">
    <!-- Tier 4 screen #4 (new-character creator) slice 4: the TRAITS tab
         (set_traits). Character-tab strip (TRAITS current) + a top bar (points +
         good/bad budget + the working trait's cost line) + three side-by-side
         columns (good / bad / neutral; the neutral column hides when empty) +
         a description footer for the working trait. Only the working column's
         cursor row is highlighted. Render-only doc; keyboard owns LEFT/RIGHT
         (switch column), UP/DOWN (move), CONFIRM (toggle trait), RANDOMIZE,
         REROLL_*, NEXT/PREV_TAB, QUIT. The tile character preview is not drawn
         in rml mode this slice. -->
    <div class="panel nc-panel">
        <div class="tabs nc-tabs">
            <div class="item tab" data-for="t : tabs"
                 data-class-selected="t.selected">
                <div class="nc-tab-icon" data-style-decorator="t.icon_dec"></div>
                <span class="nc-tab-label" data-rml="t.name_rml"></span>
            </div>
        </div>
        <div class="nc-trait-top">
            <span class="nc-trait-points" data-rml="points_rml"></span>
            <span class="nc-trait-cost" data-rml="cost_rml"></span>
        </div>
        <!-- Own row, not inside .nc-trait-top: at 230dp wedged between the
             points and cost lines the scale read as clutter rather than as an
             indicator. -->
        <div class="nc-balance-row" data-if="balance.show">
            <!-- No absolute positioning anywhere: RmlUi resolved `position: absolute`
                 against .nc-panel rather than against .nc-scale's `position: relative`,
                 which put the beam ~39dp above the pans and across the top bar. Pure
                 flow instead: arm row (pan | beam | pan) with the fulcrum beneath. -->
            <div class="nc-scale">
                <div class="nc-scale-arm">
                    <div class="nc-scale-pan" data-style-top="balance.good_top">
                        <div class="nc-scale-icon" data-style-decorator="balance.good_icon"></div>
                        <span class="nc-scale-num" data-rml="balance.good_rml"></span>
                    </div>
                    <div class="nc-scale-beam" data-style-transform="balance.rotate"></div>
                    <div class="nc-scale-pan" data-style-top="balance.bad_top">
                        <span class="nc-scale-num" data-rml="balance.bad_rml"></span>
                        <div class="nc-scale-icon" data-style-decorator="balance.bad_icon"></div>
                    </div>
                </div>
                <div class="nc-scale-fulcrum" data-style-decorator="balance.fulcrum_icon"></div>
            </div>
        </div>
        <div class="nc-trait-cols">
            <div id="nc-trait-col0" class="nc-trait-col scroll-pane" data-rml="col0_html"></div>
            <div id="nc-trait-col1" class="nc-trait-col scroll-pane" data-rml="col1_html"></div>
            <div id="nc-trait-col2" class="nc-trait-col scroll-pane" data-rml="col2_html"
                 data-if="show_col2"></div>
        </div>
        <div class="nc-trait-desc" data-rml="desc_rml"></div>
    </div>
    <div id="crt-overlay" class="crt"></div>
</body>
</rml>
