/* Layout for the nearby-monster list (§8.1 backlog: game::list_monsters).
   Palette/border/scrollbar/.scroll-pane come from theme.rcss (linked first in
   list_monsters.rml); this file owns only the screen's own layout. Lengths in dp.

   A right-docked panel (the curses screen sat top-right, width ~45 cols): a
   header (Monsters + counter), a scrolling list, the selected creature's
   info-title + scrolling info pane, and a footer hint line. Monster rows are
   flex (name | right-aligned meta); category headers + empty message are plain
   blocks. List/info are .scroll-pane block containers (RmlUi divs default to
   inline — see the theme.rcss gotcha). Per-segment colour is baked into the
   bound spans via cata_text_to_rml, so this file only positions. The selected
   row gets the shared accent highlight. */
body {
    display: flex;
    justify-content: flex-end;
    align-items: stretch;
    width: 100%;
    height: 100%;
}

.lm-panel {
    width: 34%;
    max-width: 520dp;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.lm-header {
    flex: 0 0 auto;
    color: {{fg}};
    border-bottom: 1dp {{bg4}};
    padding-bottom: 2dp;
    margin-bottom: 2dp;
    white-space: nowrap;
}

/* The scrolling creature list. Takes the larger share of the panel. */
.lm-list {
    flex: 2 1 0;
    min-height: 0;
}

.lm-empty {
    display: block;
    color: {{fg}};
    padding: 4dp 2dp;
}

.lm-row {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    white-space: nowrap;
}

.lm-row.selected {
    background-color: {{yellow}};
    color: {{bg-hard}};
}

/* Attitude-category header row (magenta, baked) — spans the full width. */
.lm-row.cat {
    display: block;
}

.lm-cat {
    display: block;
}

.lm-name {
    display: block;
    flex: 1;
    min-width: 0;
    text-overflow: ellipsis;
}

/* HP-bar / attitude / distance cluster, right-aligned after the name. */
.lm-meta {
    display: block;
    flex: 0 0 auto;
    padding-left: 6dp;
    white-space: nowrap;
}

/* Selected-creature info title + scrolling info pane (print_info_text). */
.lm-info-title {
    flex: 0 0 auto;
    border-top: 1dp {{bg4}};
    padding-top: 2dp;
    margin-top: 2dp;
    white-space: nowrap;
}

.lm-info {
    flex: 1 1 0;
    min-height: 0;
    white-space: pre-wrap;
}

.lm-footer {
    flex: 0 0 auto;
    border-top: 1dp {{bg4}};
    padding-top: 2dp;
    margin-top: 2dp;
    color: {{fg4}};
    white-space: nowrap;
}
