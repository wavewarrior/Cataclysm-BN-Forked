{
  "//": "Sidebar widget icon registry. Maps a logical icon id (used in C++ and in",
  "//1": "data/json/ui/sidebar.json's \"icon\" field) to an SVG file in this folder.",
  "//2": "Swap art by editing \"svg\" — no recompile. An id absent here falls back to",
  "//3": "\"<id>.svg\". The optional \"animations\" array is consumed by the sidebar",
  "//4": "animation system (see ui_tween / sidebar_anim); omit it for a static icon.",
  "//anim": "Each animation: trigger (on_change|critical|ambient), property",
  "//anim2": "(scale|alpha|offset_y|rotation|color_blend), from/to, duration(ms),",
  "//anim3": "ease (linear|sine_*|quad_*|cubic_*|quart_*|expo_*|back_*|elastic_*|",
  "//anim4": "bounce_* with _in/_out/_in_out), loop (once|loop|pingpong), repeats,",
  "//anim5": "and color (for color_blend). Omit \"animations\" for a static icon.",
  "//row": "Reserved pseudo-icon \"_row\" drives row-level effects (a full-width",
  "//row2": "highlight bar via the color_blend property). Off by default; add a",
  "//row3": "\"_row\" entry with an animations array to enable. Never drawn as an icon.",
  "//dir": "Directional change: on_increase/on_decrease fire by the sign of the",
  "//dir2": "change. Used here with property scale_y + pivot (0 top, 1 bottom) for a",
  "//dir3": "squash anchored to an edge — the icon recoils as if hit from that side.",
  "icons": [
    {
      "id": "heart", "svg": "heart.svg",
      "animations": [
        { "trigger": "on_increase", "property": "scale_y", "from": 0.6, "to": 1.0, "duration": 320, "ease": "back_out", "pivot": 0.0 },
        { "trigger": "on_decrease", "property": "scale_y", "from": 0.6, "to": 1.0, "duration": 320, "ease": "back_out", "pivot": 1.0 },
        { "trigger": "critical", "property": "alpha", "from": 1.0, "to": 0.35, "duration": 280, "ease": "sine_in_out", "loop": "pingpong", "repeats": 6 }
      ]
    },
    {
      "id": "droplet", "svg": "droplet.svg",
      "animations": [
        { "trigger": "on_increase", "property": "scale_y", "from": 0.6, "to": 1.0, "duration": 320, "ease": "back_out", "pivot": 0.0 },
        { "trigger": "on_decrease", "property": "scale_y", "from": 0.6, "to": 1.0, "duration": 320, "ease": "back_out", "pivot": 1.0 }
      ]
    },
    {
      "id": "food", "svg": "food.svg",
      "animations": [
        { "trigger": "on_increase", "property": "scale_y", "from": 0.6, "to": 1.0, "duration": 320, "ease": "back_out", "pivot": 0.0 },
        { "trigger": "on_decrease", "property": "scale_y", "from": 0.6, "to": 1.0, "duration": 320, "ease": "back_out", "pivot": 1.0 }
      ]
    },
    { "id": "sound",   "svg": "sound.svg" },
    {
      "id": "spark", "svg": "spark.svg",
      "animations": [
        { "trigger": "on_change", "property": "scale", "from": 1.3, "to": 1.0, "duration": 300, "ease": "back_out" },
        { "trigger": "ambient", "property": "rotation", "from": 0, "to": 360, "duration": 6000, "ease": "linear", "loop": "loop" }
      ]
    },
    {
      "id": "compass", "svg": "compass.svg",
      "animations": [
        { "trigger": "ambient", "property": "rotation", "from": 0, "to": 360, "duration": 12000, "ease": "linear", "loop": "loop" }
      ]
    },

    {
      "id": "moon", "svg": "moon.svg",
      "animations": [
        { "trigger": "on_change", "property": "scale", "from": 1.2, "to": 1.0, "duration": 450, "ease": "back_out" }
      ]
    },
    { "id": "moon_new",              "svg": "moon_new.svg" },
    { "id": "moon_waxing_crescent",  "svg": "moon_waxing_crescent.svg" },
    { "id": "moon_first_quarter",    "svg": "moon_first_quarter.svg" },
    { "id": "moon_waxing_gibbous",   "svg": "moon_waxing_gibbous.svg" },
    { "id": "moon_full",             "svg": "moon_full.svg" },
    { "id": "moon_waning_gibbous",   "svg": "moon_waning_gibbous.svg" },
    { "id": "moon_last_quarter",     "svg": "moon_last_quarter.svg" },
    { "id": "moon_waning_crescent",  "svg": "moon_waning_crescent.svg" },

    {
      "id": "wind", "svg": "wind.svg",
      "animations": [
        { "trigger": "on_change", "property": "scale", "from": 1.2, "to": 1.0, "duration": 350, "ease": "back_out" }
      ]
    },
    { "id": "wind_n",  "svg": "wind_n.svg" },
    { "id": "wind_ne", "svg": "wind_ne.svg" },
    { "id": "wind_e",  "svg": "wind_e.svg" },
    { "id": "wind_se", "svg": "wind_se.svg" },
    { "id": "wind_s",  "svg": "wind_s.svg" },
    { "id": "wind_sw", "svg": "wind_sw.svg" },
    { "id": "wind_w",  "svg": "wind_w.svg" },
    { "id": "wind_nw", "svg": "wind_nw.svg" },
    {
      "id": "hud_vbar", "svg": "",
      "animations": [
        { "trigger": "critical", "property": "alpha", "from": 1.0, "to": 0.3, "duration": 400, "ease": "sine_in_out", "loop": "pingpong", "repeats": 4 },
        { "trigger": "on_decrease", "property": "offset_y", "from": 3, "to": 0, "duration": 250, "ease": "back_out" },
        { "trigger": "on_increase", "property": "offset_y", "from": -2, "to": 0, "duration": 200, "ease": "back_out" }
      ]
    },
    {
      "id": "hud_log_entry", "svg": "",
      "animations": [
        { "trigger": "ambient", "property": "offset_y", "from": 5, "to": 0, "duration": 200, "ease": "back_out", "loop": "once" },
        { "trigger": "ambient", "property": "alpha", "from": 0.0, "to": 1.0, "duration": 200, "ease": "quad_out", "loop": "once" }
      ]
    },
    {
      "id": "status_poison", "svg": "status_poison.svg",
      "animations": [
        { "trigger": "ambient", "property": "alpha", "from": 0.5, "to": 1.0, "duration": 1200, "ease": "sine_in_out", "loop": "pingpong" }
      ]
    },
    {
      "id": "status_fire", "svg": "status_fire.svg",
      "animations": [
        { "trigger": "ambient", "property": "scale", "from": 1.0, "to": 1.1, "duration": 800, "ease": "sine_in_out", "loop": "pingpong" }
      ]
    },
    {
      "id": "status_bleed", "svg": "status_bleed.svg",
      "animations": [
        { "trigger": "ambient", "property": "alpha", "from": 0.3, "to": 1.0, "duration": 600, "ease": "sine_in_out", "loop": "pingpong" }
      ]
    },
    {
      "id": "status_rad", "svg": "status_rad.svg",
      "animations": [
        { "trigger": "ambient", "property": "rotation", "from": -3, "to": 3, "duration": 1000, "ease": "sine_in_out", "loop": "pingpong" }
      ]
    }
  ]
}
