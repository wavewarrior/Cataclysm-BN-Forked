# Day and night captures of the same spot, for HUMAN judgement of contrast, readability
# and shadow hardness (POINT_K_GAIN).
#
# PREREQUISITE: a THROWAWAY clone of an explored save, --var WORLD=<name>. See
# lightmode-world.vv for the clone command and why it must be a save you can lose.
#
# No F7 and no debug views on purpose: mode 0 is what a human needs to look at, and this
# scenario stays usable against older binaries, which do not log the debug mode and would
# stall a `waitlog "lighting debug mode N"` for its whole timeout.
#
# Hour is set to 01:00 through the debug menu using the sequence proven in light-scene.vv:
#   ESC -> c (Debug Menu) -> m -> t -> h, clear the field, type 1, ENTER, ESC out.
launch --dont-debugmsg --world ${WORLD}
waitlog "opened document .*sidebar_hud.rml" timeout=300000
focus
settle timeout=25000

# The window resizes shortly after the world loads (measured 1920x1080, then 2560x1440
# 1.5 s later), so discard a warm-up capture and settle again: a size change between two
# measured shots aborts the run.
shot warmup avg=4
wait 6000
settle timeout=15000

# Conservative rect well inside the map viewport. The HUD sidebar and message bar are drawn
# on is_lit=false segments and are not part of the lighting composite at all.
rect play 0.25,0.12,0.55,0.80

shot day avg=12
stats day in=play

# ---- set the clock to 01:00 ----
key "{ESC}"
wait 1800
key "c"
wait 2000
key "m"
wait 1800
key "t"
wait 2000
key "h"
wait 1500
key "{BACKSPACE}"
wait 300
key "{BACKSPACE}"
wait 300
key "1"
wait 500
key "{ENTER}"
wait 1500
key "{ESC}"
wait 1200
key "{ESC}"
wait 1200
key "{ESC}"
wait 4000

shot night avg=12
stats night in=play
diff day night as=daynight in=play

# The clock change MUST have landed. Menu driving is the flaky part of this harness, and a
# single dropped key would leave `night` as a second DAYLIGHT frame -- which would look
# entirely plausible sitting in a folder of screenshots. Measured day->night moves ~81% of
# the play area; the paired same-state null is ~0.04%. 20% is far above any scene churn and
# far below the real transition.
assert daynight.pct > 20

log
stop
