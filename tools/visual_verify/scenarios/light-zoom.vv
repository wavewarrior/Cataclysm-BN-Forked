# Zoom ladder over the same lighting-heavy scene.
#
# Hypothesis under test: the hard dot lattice over lit ground is aliasing of the
# art-texel light quantisation + 4x4 Bayer dither, not a debug overlay.
#   sprite.frag.hlsl:561  shade_pos snaps to 1/texels_per_tile (default 32)
#   sprite.frag.hlsl:798  dither_threshold(shade_pos * texels_per_tile), 4x4 Bayer
# At ~8 screen px per tile, 32 art texels are 0.25 px each, so a whole 4x4 Bayer
# cell collapses inside one screen pixel and neighbouring pixels sample unrelated
# thresholds. Prediction: zooming IN (bigger tiles) must resolve the stipple into
# a fine intra-tile pattern and the lattice must fade. If the lattice is instead
# zoom-invariant, it is an overlay and the hypothesis is wrong.
launch --dont-debugmsg
waitlog "opened document data/gui/mainmenu.rml" timeout=240000
focus
key "o"
wait 800
key "{ENTER}"
wait 1500
key "h"
wait 3000
key "{ENTER}"
wait 8000
key "{SPACE}"
wait 1500
key "{SPACE}"
wait 1500
key "{SPACE}"
wait 1500
key "{SPACE}"
waitlog "opened document .*sidebar_hud.rml" timeout=300000
wait 6000
key "!"
wait 1500

# ---- night ----
key "{ESC}"
wait 1800
key "c"
wait 2000
key "m"
wait 1800
key "t"
wait 2000
key "h"
wait 1500
key "{BACKSPACE}"
wait 300
key "{BACKSPACE}"
wait 300
key "1"
wait 500
key "{ENTER}"
wait 1500
key "{ESC}"
wait 1200
key "{ESC}"
wait 1200
key "{ESC}"
wait 3000

# ---- lights ----
key "{ESC}"
wait 1800
key "c"
wait 2000
key "l"
wait 3000
key "{ENTER}"
wait 2500
key "require(\"lib.lightscene\")"
wait 2000
key "{CTRL+S}"
wait 5000
key "{ESC}"
wait 4000
shot zoom_base

key "z"
wait 1500
key "z"
wait 3000
shot zoom_in2
key "z"
wait 1500
key "z"
wait 3000
shot zoom_in4
key "z"
wait 1500
key "z"
wait 3000
shot zoom_in6
