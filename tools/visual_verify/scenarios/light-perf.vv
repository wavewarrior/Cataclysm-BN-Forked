# Performance pass: baseline and loaded in ONE session.
#
# Both phases run in the same launch on purpose - same GPU state, same world,
# same driver warm-up - so the only difference between the two perf windows is
# the scene itself. Splitting across launches would fold cold-pool warmup and
# driver variance into the comparison.
#
# Movement is '.' (WAIT, one turn) rather than walking: turns still advance so
# monster AI, fields and the world tick are exercised, but the player never
# moves, so no map shift and no change in what is on screen. That isolates the
# lighting/monster cost from submap streaming.
launch --dont-debugmsg
waitlog "opened document data/gui/mainmenu.rml" timeout=240000
focus
key "o"
wait 800
key "{ENTER}"
wait 1500
key "h"
wait 3000
key "{ENTER}"
wait 8000
key "{SPACE}"
wait 1500
key "{SPACE}"
wait 1500
key "{SPACE}"
wait 1500
key "{SPACE}"
waitlog "opened document .*sidebar_hud.rml" timeout=300000
wait 6000
key "!"
wait 1500

# ---- night ----
key "{ESC}"
wait 1800
key "c"
wait 2000
key "m"
wait 1800
key "t"
wait 2000
key "h"
wait 1500
key "{BACKSPACE}"
wait 300
key "{BACKSPACE}"
wait 300
key "1"
wait 500
key "{ENTER}"
wait 1500
key "{ESC}"
wait 1200
key "{ESC}"
wait 1200
key "{ESC}"
wait 3000

# ---- BASELINE: empty night scene, 20 turns + idle render windows ----
wait 12000
key "...................."
wait 12000
shot perf_baseline

# ---- load the scene ----
key "{ESC}"
wait 1800
key "c"
wait 2000
key "l"
wait 3000
key "{ENTER}"
wait 2500
key "require(\"lib.lightscene\")"
wait 2000
key "{CTRL+S}"
wait 4000
key "{ENTER}"
wait 2000
key "require(\"lib.lightmobs\")"
wait 2000
key "{CTRL+S}"
wait 4000
key "{ESC}"
wait 3000

# ---- LOADED: same 20 turns + idle render windows ----
wait 12000
key "...................."
wait 12000
shot perf_loaded
