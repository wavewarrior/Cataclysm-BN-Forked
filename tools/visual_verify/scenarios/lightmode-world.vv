# PREREQUISITE: a THROWAWAY clone of an explored save, passed as --var WORLD=<name>.
#
#   cp -r "out/install/windows-tiles-sounds-x64-msvc/save/<explored world>" \
#         "out/install/windows-tiles-sounds-x64-msvc/save/LIGHTAB"
#   python tools/visual_verify/vv.py run tools/visual_verify/scenarios/lightmode-world.vv --var WORLD=LIGHTAB
#
# It MUST be a clone you are willing to lose: this scenario drives the debug menu and
# the game may autosave, so pointing it at a save you care about will edit that save.
# An explored save is required rather than a fresh or Lua-built one, because terrain the
# character has never SEEN renders from map memory and bypasses GPU lighting entirely,
# so a fabricated scene cannot test this change at all.
#
# In-game gate for the lighting-composition change: the memory branch, the Step 8
# frontier cross-fade, and the categorical light_mode classification.
#
# Loads a CLONE of an explored world (save/LIGHTAB, copied from an existing save so
# the user's own saves are never opened) via --world, which lands straight in
# gameplay with zero main-menu navigation. A loaded, explored save is the only way to
# get REAL remembered terrain: Lua-fabricated tiles the character has never seen
# render from map memory and bypass GPU lighting entirely, so a scene built that way
# cannot test this change at all.
#
# Zoom is deliberately NOT touched. Zoom keypresses get dropped, so two runs of the
# same scenario can land on different zoom levels -- measured 8.02 px vs 42.86 px tile
# pitch, moving whole-frame mean luma by 19.7 and manufacturing a 67% "signal" out of
# nothing.
#
# F7 cycles debug_mode 0..16 and LOGS the mode it landed on. Fifteen presses reach
# view 15 (vision frontier, frontier_cov in GREEN), one more reaches view 16
# (categorical light_mode: red unlit / green gpu_lit / blue memory), one more wraps to
# 0. Presses are issued individually rather than as {F7*15} because batched repeats
# get dropped -- and every capture is gated on `waitlog` confirming the mode from the
# log, so a dropped press fails the run instead of silently handing back a capture of
# the wrong mode.
launch --dont-debugmsg --world ${WORLD}
waitlog "opened document .*sidebar_hud.rml" timeout=300000
focus
settle timeout=25000

# The window RESIZES shortly after the world finishes loading -- measured: a first
# capture at 1920x1080 followed by 2560x1440 only 1.5 s later, which aborts the run with
# "size mismatch". `settle` returns before that happens (it reported 4.3 s), so discard a
# warm-up capture and settle again before anything is measured.
shot warmup avg=4
wait 6000
settle timeout=15000

# Play area only: the HUD sidebar is drawn unlit through a separate batcher and would
# dilute every world-tile measurement.
# The `play` rect is deliberately CONSERVATIVE and sits well inside the map viewport.
# It is not "most of the screen": the HUD sidebar (right ~15%) and the message bar
# (top ~10%) are drawn on is_lit=false segments, where sprite_batcher.cpp forces
# debug_mode = 0, so they render NORMALLY and are not categorical at all. A rect that
# includes them reports HUD pixels as "unclassified" and hides the real signal -- with
# the old 0.02,0.02,0.70,0.92 rect that inflated unclassified to 16-28%, and a white-
# marker control read rgb[71.9, 52.9, 11.0] (warm HUD) in its top-left corner against
# rgb[243.5, 243.5, 243.5] (neutral, correct) in the centre. Verified by locating the
# achromatic region of that control: this rect measures rgb[233.8, 233.7, 233.3].
rect play 0.25,0.12,0.55,0.80

shot world avg=12
wait 1500
shot world_again avg=12
diff world world_again as=same_state in=play
stats world in=play

# ---- debug view 15: vision frontier ----
key "{F7}"
wait 250
key "{F7}"
wait 250
key "{F7}"
wait 250
key "{F7}"
wait 250
key "{F7}"
wait 400
key "{F7}"
wait 250
key "{F7}"
wait 250
key "{F7}"
wait 250
key "{F7}"
wait 250
key "{F7}"
wait 400
key "{F7}"
wait 250
key "{F7}"
wait 250
key "{F7}"
wait 250
key "{F7}"
wait 250
key "{F7}"
waitlog "lighting debug mode 15" timeout=20000
wait 2500
shot frontier15 avg=6

# ---- debug view 16: categorical light_mode ----
key "{F7}"
waitlog "lighting debug mode 16" timeout=20000
wait 2500
shot mode16 avg=6

# ---- wrap to 0 and require the scene to come back identically ----
key "{F7}"
waitlog "lighting debug mode 0" timeout=20000
wait 3000
shot world_restored avg=12
diff world world_restored as=restore in=play

# A lone before/after proves nothing: it equally supports "it worked" and "the input
# never arrived". The restore must land back inside the paired same-state null.
assert restore.changed < same_state.changed * 3

log
stop
